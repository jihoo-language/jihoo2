import std.fmt

const PI: f64 = 3.141592653589793
const SOLAR_MASS: f64 = 4.0 * PI * PI
const DAYS: f64 = 365.24

struct Body {
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    m: f64
}

fn energy(bodies: [Body; 5]) -> f64 {
    var e = 0.0
    for i in 0..5 {
        let b = bodies[i]
        e = e + 0.5 * b.m * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in i + 1..5 {
            let c = bodies[j]
            let dx = b.x - c.x
            let dy = b.y - c.y
            let dz = b.z - c.z
            e = e - b.m * c.m / sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    e
}

fn advance(inout bodies: [Body; 5], dt: f64) {
    for i in 0..5 {
        for j in i + 1..5 {
            let dx = bodies[i].x - bodies[j].x
            let dy = bodies[i].y - bodies[j].y
            let dz = bodies[i].z - bodies[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * sqrt(d2))
            let mi = bodies[i].m
            let mj = bodies[j].m
            bodies[i].vx = bodies[i].vx - dx * mj * mag
            bodies[i].vy = bodies[i].vy - dy * mj * mag
            bodies[i].vz = bodies[i].vz - dz * mj * mag
            bodies[j].vx = bodies[j].vx + dx * mi * mag
            bodies[j].vy = bodies[j].vy + dy * mi * mag
            bodies[j].vz = bodies[j].vz + dz * mi * mag
        }
    }
    for i in 0..5 {
        bodies[i].x = bodies[i].x + dt * bodies[i].vx
        bodies[i].y = bodies[i].y + dt * bodies[i].vy
        bodies[i].z = bodies[i].z + dt * bodies[i].vz
    }
}

fn main() {
    var bodies = [
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, m: SOLAR_MASS },
        Body {
            x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01,
            vx: 1.66007664274403694e-03 * DAYS, vy: 7.69901118419740425e-03 * DAYS,
            vz: -6.90460016972063023e-05 * DAYS, m: 9.54791938424326609e-04 * SOLAR_MASS
        },
        Body {
            x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01,
            vx: -2.76742510726862411e-03 * DAYS, vy: 4.99852801234917238e-03 * DAYS,
            vz: 2.30417297573763929e-05 * DAYS, m: 2.85885980666130812e-04 * SOLAR_MASS
        },
        Body {
            x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01,
            vx: 2.96460137564761618e-03 * DAYS, vy: 2.37847173959480950e-03 * DAYS,
            vz: -2.96589568540237556e-05 * DAYS, m: 4.36624404335156298e-05 * SOLAR_MASS
        },
        Body {
            x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01,
            vx: 2.68067772490389322e-03 * DAYS, vy: 1.62824170038242295e-03 * DAYS,
            vz: -9.51592254519715870e-05 * DAYS, m: 5.15138902046611451e-05 * SOLAR_MASS
        }
    ]
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    for i in 0..5 {
        px = px + bodies[i].vx * bodies[i].m
        py = py + bodies[i].vy * bodies[i].m
        pz = pz + bodies[i].vz * bodies[i].m
    }
    bodies[0].vx = 0.0 - px / SOLAR_MASS
    bodies[0].vy = 0.0 - py / SOLAR_MASS
    bodies[0].vz = 0.0 - pz / SOLAR_MASS
    fmt.println("{:.9}", (energy(bodies),))
    for _ in 0..50000000 { advance(&bodies, 0.01) }
    fmt.println("{:.9}", (energy(bodies),))
}
