import std.sort

fn main() {
    let n = 5000000
    var seed = 42
    var a = Vec(i64).with_capacity(n)
    for _ in 0..n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.push(seed)
    }
    sort.sort_by(&a, fn(x, y) { x < y })
    var ok = true
    for i in 0..n - 1 {
        if a[i] > a[i + 1] { ok = false }
    }
    println(ok)
    println(a[0])
    println(a[n - 1])
}
