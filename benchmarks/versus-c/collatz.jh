import std.fmt

fn steps(n: u64) -> u32 {
    var k: u32 = 0
    var m = n
    while m != 1 && k < 4000000000 {
        if m & 1 == 0 { m = m >> 1 } else { m = 3 * m + 1 }
        k += 1
    }
    k
}

fn main() {
    var best: u64 = 0
    var arg: u64 = 0
    var i: u64 = 1
    while i < 5000000 {
        let s = steps(i) as u64
        if s > best {
            best = s
            arg = i
        }
        i += 1
    }
    fmt.println("{} {}", (arg, best))
}
