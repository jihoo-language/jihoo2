fn main() {
    var total = 0
    for _ in 0..5 {
        let n = 50000000
        var a = Vec(bool).filled(n, true)
        a[0] = false
        a[1] = false
        var i = 2
        while i * i < n {
            if a[i] {
                var j = i * i
                while j < n {
                    a[j] = false
                    j += i
                }
            }
            i += 1
        }
        var c = 0
        for x in a {
            if x { c += 1 }
        }
        total += c
    }
    println(total)
}
