// An untrusted prover for verification: Fourier-Motzkin elimination that
// remembers how each derived fact was made from the goal's facts, so a
// contradiction comes with the weights `linear.check` needs. Its bugs can
// only lose proofs.

import std.sort
import forms
import linear

type Lin = linear.Lin

struct Row {
    lin: Lin
    // The weight of each original fact; the last is the negated claim's.
    // Sparse, by increasing fact.
    weights: Vec((i64, i128))
}

const MAX_ROWS: i64 = 4096
// The terms and weights of the rows derived in one step, at most: rows of
// many weights cost memory faster than their number says.
const MAX_ENTRIES: i64 = 1 << 20

fn gcd(a: i128, b: i128) -> i128 {
    var x = forms.abs(a)
    var y = forms.abs(b)
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    x
}

// Divides a row by the common factor of all its numbers, which keeps the
// row equal to the weighted sum of its originals.
fn reduce(sink r: Row) -> Row {
    var g = gcd(r.lin.constant, 0)
    for t in r.lin.terms { g = gcd(g, t.1) }
    for w in r.weights { g = gcd(g, w.1) }
    if g <= 1 { return r }
    var terms = Vec((i64, i128)).with_capacity(r.lin.terms.len())
    for t in r.lin.terms { terms.push((t.0, t.1 / g)) }
    var weights = Vec((i64, i128)).with_capacity(r.weights.len())
    for w in r.weights { weights.push((w.0, w.1 / g)) }
    Row { lin: Lin { terms, constant: r.lin.constant / g }, weights }
}

// Products stay below 2^120; past that a row is dropped, which loses proofs
// but never makes one.
const LIMIT: i128 = 1 << 120

fn fits(x: i128, k: i128) -> bool { k == 0 || forms.abs(x) <= LIMIT / forms.abs(k) }

fn row_fits(r: Row, k: i128) -> bool {
    if !fits(r.lin.magnitude(), k) { return false }
    for w in r.weights {
        if !fits(w.1, k) { return false }
    }
    true
}

// p * a + q * b of two sparse weight lists.
fn mix(p: [(i64, i128)], a: i128, q: [(i64, i128)], b: i128) -> Vec((i64, i128)) {
    var out = Vec((i64, i128)).with_capacity(p.len + q.len)
    var i = 0
    var j = 0
    while i < p.len || j < q.len {
        if j == q.len || (i < p.len && p[i].0 < q[j].0) {
            out.push((p[i].0, p[i].1 * a))
            i += 1
        } else if i == p.len || q[j].0 < p[i].0 {
            out.push((q[j].0, q[j].1 * b))
            j += 1
        } else {
            out.push((p[i].0, p[i].1 * a + q[j].1 * b))
            i += 1
            j += 1
        }
    }
    out
}

fn combine(p: Row, a: i128, q: Row, b: i128) -> Option(Row) {
    if !row_fits(p, a) || !row_fits(q, b) { return None }
    let weights = mix(p.weights.as_slice(), a, q.weights.as_slice(), b)
    Some(reduce(Row { lin: p.lin.combine(a, q.lin, b), weights }))
}

// The position of `v` in the sorted `ids`.
fn position(ids: [i64], v: i64) -> i64 {
    var lo = 0
    var hi = ids.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if ids[mid] < v { lo = mid + 1 } else { hi = mid }
    }
    lo
}

// The form over the variables' positions in `ids`.
fn renumber(x: Lin, ids: [i64]) -> Lin {
    var terms = Vec((i64, i128)).with_capacity(x.terms.len())
    for t in x.terms { terms.push((position(ids, t.0), t.1)) }
    Lin { terms, constant: x.constant }
}

// The facts that share a variable with the claim, directly or through other
// such facts, by how many facts away they are (0 for those that name the
// claim's variables), -1 for the others. Those cannot help unless they
// contradict each other, so their weight stays zero. With `latest`, instead
// those that share one with the latest facts that do not name the claim's
// (the conditions that led here, a case of a disjunction), which may; so
// do they for a claim without variables (the path cannot be taken).
fn relevant(facts: [Lin], claim: Lin, n: i64, latest: bool) -> Vec(i64) {
    var seen = Vec(bool).filled(n, false)
    if !latest {
        for t in claim.terms { seen[t.0] = true }
    }
    if latest || claim.is_constant() {
        var k = facts.len
        while k > 0 && facts.len - k < 8 {
            k -= 1
            // With `latest`, not the range facts of the claim's variables.
            var mine = false
            for t in facts[k].terms {
                if latest && claim.coef(t.0) != 0 { mine = true }
            }
            if !mine {
                for t in facts[k].terms { seen[t.0] = true }
            }
        }
    }
    var level = Vec(i64).filled(facts.len, -1)
    var changed = true
    var round = 0
    while changed {
        changed = false
        // The variables of the facts this round takes, seen in the next.
        var more = Vec(i64).new()
        for i, f in facts {
            if level[i] < 0 {
                var touches = f.is_constant() && f.constant < 0
                for t in f.terms {
                    if seen[t.0] { touches = true }
                }
                if touches {
                    level[i] = round
                    changed = true
                    for t in f.terms { more.push(t.0) }
                }
            }
        }
        for v in more { seen[v] = true }
        round += 1
    }
    level
}

// A type's range: a bound beyond 2^62, which rarely helps.
fn is_range(x: Lin) -> bool { x.terms.len() == 1 && forms.abs(x.constant) >= 1 << 62 }

// The `cap` relevant facts nearest the claim (all of them if `cap` is
// negative): by level, then single bounds before relations and ranges
// last.
fn nearest(facts: [Lin], level: [i64], cap: i64) -> Vec(bool) {
    // The rank, then the fact's index, in one number.
    var order = Vec(i64).new()
    for i, f in facts {
        if level[i] >= 0 {
            let rank = level[i] * 1024 + (if is_range(f) { 512 } else { 0 }) + f.terms.len()
            order.push(rank * (1 << 32) + i)
        }
    }
    sort.sort(&order)
    var used = Vec(bool).filled(facts.len, false)
    for k, x in order {
        if cap >= 0 && k >= cap { break }
        used[x % (1 << 32)] = true
    }
    used
}

// The variable whose elimination makes the fewest new rows, or -1 when no
// row has a variable left. A variable whose coefficients are all 1 or -1
// comes first: eliminating it loses no integer points (the Omega test's
// exact elimination), while eliminating `k` from `x = 2k` forgets that
// `x` is even, which a cut needs later.
fn pick(rows: [Row], n: i64) -> i64 {
    var pos = Vec(i64).filled(n, 0)
    var neg = Vec(i64).filled(n, 0)
    var exact = Vec(bool).filled(n, true)
    for r in rows {
        for t in r.lin.terms {
            if t.1 > 0 { pos[t.0] += 1 } else { neg[t.0] += 1 }
            if t.1 != 1 && t.1 != -1 { exact[t.0] = false }
        }
    }
    var best = -1
    var best_cost = 0
    var best_exact = false
    for v in 0..n {
        if pos[v] + neg[v] > 0 {
            let cost = pos[v] * neg[v] - pos[v] - neg[v]
            let better = if exact[v] != best_exact { exact[v] } else { cost < best_cost }
            if best < 0 || better {
                best = v
                best_cost = cost
                best_exact = exact[v]
            }
        }
    }
    best
}

// A cut on its way to a certificate: the weights of the rows it sums, by
// their numbers in the prover (the cuts after the `m` facts and claim).
struct Pending {
    weights: Vec((i64, i128))
    divisor: i128
}

// The integers between rationals: when a row's coefficients share a
// factor its constant does not, the row divided by it may round its
// constant down (a cut), which elimination over the rationals cannot.
// The row becomes the cut itself.
fn tighten(sink r: Row, inout cuts: Vec(Pending), m: i64) -> Row {
    if r.lin.terms.len() == 0 || cuts.len() >= linear.MAX_CUTS { return r }
    var g: i128 = 0
    for t in r.lin.terms { g = gcd(g, t.1) }
    if g <= 1 || r.lin.constant % g == 0 { return r }
    var terms = Vec((i64, i128)).with_capacity(r.lin.terms.len())
    for t in r.lin.terms { terms.push((t.0, t.1 / g)) }
    var c = r.lin.constant / g
    if r.lin.constant % g < 0 { c -= 1 }
    var weights = Vec((i64, i128)).new()
    weights.push((m + cuts.len(), 1))
    cuts.push(Pending { weights: r.weights.clone(), divisor: g })
    Row { lin: Lin { terms, constant: c }, weights }
}

// The certificate of the contradiction `r`, with the cuts it rests on
// (directly or through other cuts) and no others.
fn certificate(r: Row, m: i64, cuts: [Pending]) -> linear.Certificate {
    var need = Vec(bool).filled(cuts.len, false)
    for w in r.weights {
        if w.0 >= m { need[w.0 - m] = true }
    }
    var j = cuts.len
    while j > 0 {
        j -= 1
        if need[j] {
            for w in cuts[j].weights {
                if w.0 >= m { need[w.0 - m] = true }
            }
        }
    }
    var index = Vec(i64).filled(cuts.len, -1)
    var kept = 0
    for k in 0..cuts.len {
        if need[k] {
            index[k] = m + kept
            kept += 1
        }
    }
    var out = Vec(linear.Cut).new()
    for k in 0..cuts.len {
        if need[k] {
            let ws = dense(cuts[k].weights.as_slice(), m + out.len(), m, index.as_slice())
            out.push(linear.Cut { weights: ws, divisor: cuts[k].divisor })
        }
    }
    let weights = dense(r.weights.as_slice(), m + kept, m, index.as_slice())
    linear.Certificate { weights, cuts: out }
}

// Sparse weights by the prover's row numbers as `len` dense ones by the
// certificate's.
fn dense(ws: [(i64, i128)], len: i64, m: i64, index: [i64]) -> Vec(i128) {
    var out = Vec(i128).filled(len, 0)
    for w in ws {
        let k = if w.0 < m { w.0 } else { index[w.0 - m] }
        out[k] = w.1
    }
    out
}

// Which facts (and the negated claim) a certificate rests on, through its
// cuts too.
pub fn uses(c: linear.Certificate, m: i64) -> Vec(bool) {
    var need = Vec(bool).filled(c.weights.len(), false)
    for k, w in c.weights {
        if w > 0 { need[k] = true }
    }
    var j = c.cuts.len()
    while j > 0 {
        j -= 1
        if need[m + j] {
            for k, w in c.cuts[j].weights {
                if w > 0 { need[k] = true }
            }
        }
    }
    need.truncate(m)
    need
}

// Most claims follow from a few facts near them, and elimination over all
// the facts a path has can grow past its limit: the facts nearest the
// claim first, then more.
pub fn prove(g: linear.Goal) -> Result(linear.Certificate, str) {
    match differences(g) {
        Some(c) => return Ok(c)
        None => {}
    }
    // The variables the goal names, sorted, so rows use small numbers; the
    // tries below share them.
    var ids = Vec(i64).new()
    for t in g.claim.terms { ids.push(t.0) }
    for f in g.facts {
        for t in f.terms { ids.push(t.0) }
    }
    sort_unique(&ids)
    var facts = Vec(Lin).with_capacity(g.facts.len())
    for f in g.facts { facts.push(renumber(f, ids.as_slice())) }
    let claim = renumber(g.claim, ids.as_slice())
    let n = ids.len()
    var last = -1
    for cap in [8, 24, 64, -1] {
        match prove_with(facts.as_slice(), claim, n, false, cap, &last) {
            Ok(c) => return Ok(c)
            Err(_) => {}
        }
    }
    // The latest facts may contradict the others without the claim.
    if g.claim.is_constant() { return Err("no linear proof") }
    var none = -1
    match prove_with(facts.as_slice(), claim, n, true, -1, &none) {
        Ok(c) => Ok(c)
        Err(_) => Err("no linear proof")
    }
}

// `last` is how many facts the previous try used: a try that would use no
// more fails at once.
// `facts` and `claim` are the goal's over its `n` variables' positions.
fn prove_with(
    facts: [Lin],
    claim: Lin,
    n: i64,
    latest: bool,
    cap: i64,
    inout last: i64
) -> Result(linear.Certificate, str) {
    let m = facts.len + 1
    let level = relevant(facts, claim, n, latest)
    let used = nearest(facts, level.as_slice(), cap)
    var count = 0
    for u in used {
        if u { count += 1 }
    }
    if count <= last { return Err("no linear proof") }
    last = count
    // With `latest`, the claim is left out; facts that reach it were in
    // the first try.
    if latest {
        let first = relevant(facts, claim, n, false)
        for i in 0..facts.len {
            if used[i] && first[i] >= 0 { return Err("no linear proof") }
        }
    }
    var rows = Vec(Row).new()
    var cuts = Vec(Pending).new()
    for i in 0..m {
        if (i == facts.len && !latest) || (i < facts.len && used[i]) {
            var weights = Vec((i64, i128)).new()
            weights.push((i, 1))
            let lin = if i < facts.len { facts[i].clone() } else { claim.scale(-1).shift(-1) }
            rows.push(tighten(Row { lin, weights }, &cuts, m))
        }
    }
    loop {
        for r in rows {
            if r.lin.is_constant() && r.lin.constant < 0 { return Ok(certificate(
                r,
                m,
                cuts.as_slice()
            )) }
        }
        let v = pick(rows.as_slice(), n)
        if v < 0 { return Err("no linear proof") }
        // The rows without `v` go on as they are, first (moved below); a row
        // with no variables left and a non-negative constant says nothing.
        var kept = 0
        for r in rows {
            if r.lin.coef(v) == 0 && !r.lin.is_constant() { kept += 1 }
        }
        var derived = Vec(Row).new()
        var entries = 0
        for p in rows {
            let a = p.lin.coef(v)
            if a > 0 {
                for q in rows {
                    let b = q.lin.coef(v)
                    if b < 0 {
                        match combine(p, 0 - b, q, a) {
                            Some(r) => {
                                entries += r.lin.terms.len() + r.weights.len()
                                derived.push(tighten(r, &cuts, m))
                            }
                            None => {}
                        }
                        if kept + derived.len() > MAX_ROWS || entries > MAX_ENTRIES {
                            return Err("too many derived facts")
                        }
                    }
                }
            }
        }
        var next = Vec(Row).with_capacity(kept + derived.len())
        for r in rows.into_iter() {
            if r.lin.coef(v) == 0 && !r.lin.is_constant() { next.push(r) }
        }
        for r in derived.into_iter() { next.push(r) }
        rows = next
    }
}

// Difference constraints, `x - y + c >= 0` and bounds `x + c >= 0` and
// `-x + c >= 0`, contradict each other exactly when the graph with an edge
// from `x` to `y` of weight `c` for each (`y <= x + c`, with a node for
// zero) has a cycle of negative weight: its facts add up to a negative
// constant. Most facts on a path are of this kind, and a search for the
// cycle (Bellman-Ford) stays small where elimination does not.
fn differences(g: linear.Goal) -> Option(linear.Certificate) {
    let m = g.facts.len() + 1
    var ids = Vec(i64).new()
    for t in g.claim.terms { ids.push(t.0) }
    for f in g.facts {
        for t in f.terms { ids.push(t.0) }
    }
    sort_unique(&ids)
    let zero = ids.len()
    // (from, to, weight, fact), the negated claim being fact `m - 1`.
    var edges = Vec((i64, i64, i128, i64)).new()
    for i, f in g.facts {
        add_edge(f, ids.as_slice(), zero, i, &edges)
    }
    add_edge(g.claim.scale(-1).shift(-1), ids.as_slice(), zero, m - 1, &edges)
    let n = zero + 1
    // Distances from a source joined to every node with weight 0; each is
    // a sum of at most `n` weights below 2^66, far inside an i128.
    var dist = Vec(i128).filled(n, 0)
    var pred = Vec(i64).filled(n, -1)
    var last = -1
    for _ in 0..n + 1 {
        last = -1
        for k, e in edges {
            if dist[e.0] + e.2 < dist[e.1] {
                dist[e.1] = dist[e.0] + e.2
                pred[e.1] = k
                last = e.1
            }
        }
        if last < 0 { return None }
    }
    // Still changing after `n` rounds: following predecessors `n` times
    // from the last node changed ends on a negative cycle.
    var x = last
    for _ in 0..n { x = edges[pred[x]].0 }
    var weights = Vec(i128).filled(m, 0)
    var y = x
    loop {
        let e = edges[pred[y]]
        weights[e.3] += 1
        y = e.0
        if y == x { break }
    }
    Some(linear.Certificate.of(weights))
}

// The edge of fact `i`, `x`, if it is a difference or a bound.
fn add_edge(x: Lin, ids: [i64], zero: i64, i: i64, inout edges: Vec((i64, i64, i128, i64))) {
    let t = x.terms.as_slice()
    if t.len == 1 && t[0].1 == 1 {
        edges.push((position(ids, t[0].0), zero, x.constant, i))
    } else if t.len == 1 && t[0].1 == -1 {
        edges.push((zero, position(ids, t[0].0), x.constant, i))
    } else if t.len == 2 && t[0].1 == 1 && t[1].1 == -1 {
        edges.push((position(ids, t[0].0), position(ids, t[1].0), x.constant, i))
    } else if t.len == 2 && t[0].1 == -1 && t[1].1 == 1 {
        edges.push((position(ids, t[1].0), position(ids, t[0].0), x.constant, i))
    }
}

// For a report on a goal that was not proved: the least and greatest
// values of `x` that its facts allow, in every case (goal) together, as
// far as propagating bounds through the facts finds them. None for an
// unbounded side, or one past the numbers kept.
pub fn known(goals: [linear.Goal], x: Lin) -> (Option(i128), Option(i128)) {
    var lo: Option(i128) = None
    var hi: Option(i128) = None
    for k, g in goals {
        let (l, h) = range_of(g.facts.as_slice(), x)
        if k == 0 {
            lo = l
            hi = h
        } else {
            lo = match (lo, l) {
                (Some(a), Some(b)) => Some(if a < b { a } else { b })
                _ => None
            }
            hi = match (hi, h) {
                (Some(a), Some(b)) => Some(if a > b { a } else { b })
                _ => None
            }
        }
    }
    (lo, hi)
}

// Numbers past this are not kept: bounds stay where products fit.
const BOUND: i128 = 1 << 100

fn floor_div(a: i128, b: i128) -> i128 {
    let q = a / b
    if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// The least value of `k * v` given its bounds, or None.
fn least(k: i128, lo: Option(i128), hi: Option(i128)) -> Option(i128) {
    let b = if k > 0 { lo } else { hi }
    match b {
        Some(v) => if forms.abs(v) <= BOUND / forms.abs(k) { Some(k * v) } else { None }
        None => None
    }
}

fn range_of(facts: [Lin], x: Lin) -> (Option(i128), Option(i128)) {
    var n = 0
    for f in facts {
        for t in f.terms {
            if t.0 + 1 > n { n = t.0 + 1 }
        }
    }
    for t in x.terms {
        if t.0 + 1 > n { n = t.0 + 1 }
    }
    var lo = Vec(Option(i128)).filled(n, None)
    var hi = Vec(Option(i128)).filled(n, None)
    // Each fact `sum(a_i * x_i) + c >= 0` bounds each of its variables by
    // the bounds of the others; a few rounds carry bounds along chains.
    for _ in 0..4 {
        var changed = false
        for f in facts {
            if f.terms.len() > 8 { continue }
            for j, tj in f.terms {
                // The greatest value of the other terms.
                var rest: Option(i128) = Some(f.constant)
                for i, ti in f.terms {
                    if i != j {
                        let m = least(0 - ti.1, lo[ti.0], hi[ti.0])
                        rest = match (rest, m) {
                            (Some(r), Some(v)) => if forms.abs(r) <= BOUND && forms.abs(v) <=
                                BOUND { Some(r - v) } else { None }
                            _ => None
                        }
                    }
                }
                // a_j * x_j >= -rest.
                let Some(r) = rest else { continue }
                let a = tj.1
                let v = tj.0
                if a > 0 {
                    // x_j >= ceil(-r / a)
                    let b = 0 - floor_div(r, a)
                    match lo[v] {
                        Some(old) => if b > old {
                            lo[v] = Some(b)
                            changed = true
                        }
                        None => {
                            lo[v] = Some(b)
                            changed = true
                        }
                    }
                } else {
                    // x_j <= floor(r / -a)
                    let b = floor_div(r, 0 - a)
                    match hi[v] {
                        Some(old) => if b < old {
                            hi[v] = Some(b)
                            changed = true
                        }
                        None => {
                            hi[v] = Some(b)
                            changed = true
                        }
                    }
                }
            }
        }
        if !changed { break }
    }
    var min: Option(i128) = Some(x.constant)
    var max: Option(i128) = Some(x.constant)
    for t in x.terms {
        let l = least(t.1, lo[t.0], hi[t.0])
        let h = least(0 - t.1, lo[t.0], hi[t.0])
        min = match (min, l) {
            (Some(a), Some(b)) => Some(a + b)
            _ => None
        }
        max = match (max, h) {
            (Some(a), Some(b)) => Some(a - b)
            _ => None
        }
    }
    (min, max)
}

// Sorts and removes duplicates.
fn sort_unique(inout xs: Vec(i64)) {
    sort.sort(&xs)
    var out = Vec(i64).with_capacity(xs.len())
    for x in xs {
        if out.len() == 0 || out[out.len() - 1] != x { out.push(x) }
    }
    xs = out
}

#[test]
fn finds_a_negative_cycle() {
    // x - y >= 1, y - z >= 1 and 0 <= z imply x >= 2.
    var facts = Vec(Lin).new()
    facts.push(Lin.of(1).minus(Lin.of(2)).shift(-1))
    facts.push(Lin.of(2).minus(Lin.of(3)).shift(-1))
    facts.push(Lin.of(3))
    let g = linear.Goal { facts, claim: Lin.of(1).shift(-2) }
    let c = differences(g).unwrap()
    assert(linear.check(g, c).is_ok(), "checked")
    let h = linear.Goal { facts: g.facts.clone(), claim: Lin.of(1).shift(-3) }
    assert(differences(h).is_none(), "not provable")
}

#[test]
fn proves_by_a_cut() {
    // 2x = 2y + 1 has no integer solution: x - y >= 1 and x - y <= 0
    // after rounding, which the rationals (x - y = 1/2) do not give.
    var facts = Vec(Lin).new()
    facts.push(Lin.of(1).scale(2).minus(Lin.of(2).scale(2)).shift(-1))
    facts.push(Lin.of(2).scale(2).minus(Lin.of(1).scale(2)).shift(1))
    let g = linear.Goal { facts, claim: Lin.num(-1) }
    let c = prove(g).unwrap()
    assert(c.cuts.len() > 0, "with a cut")
    assert(linear.check(g, c).is_ok(), "checked")
    // An even number 2k is not 7: k <= 3 or k >= 4.
    var even = Vec(Lin).new()
    even.push(Lin.of(1).minus(Lin.of(2).scale(2)))
    even.push(Lin.of(2).scale(2).minus(Lin.of(1)))
    even.push(Lin.of(1).shift(-7))
    let h = linear.Goal { facts: even, claim: Lin.of(1).shift(-8) }
    let d = prove(h).unwrap()
    assert(linear.check(h, d).is_ok(), "x = 2k and x >= 7 give x >= 8")
}

#[test]
fn knows_a_sum() {
    // x and y in 0..=10, and y <= x - 3: x + y is in 3..=17.
    var facts = Vec(Lin).new()
    facts.push(Lin.of(0))
    facts.push(Lin.of(0).scale(-1).shift(10))
    facts.push(Lin.of(1))
    facts.push(Lin.of(1).scale(-1).shift(10))
    facts.push(Lin.of(0).minus(Lin.of(1)).shift(-3))
    var goals = Vec(linear.Goal).new()
    goals.push(linear.Goal { facts, claim: Lin.num(-1) })
    let (lo, hi) = known(goals.as_slice(), Lin.of(0).plus(Lin.of(1)))
    assert(lo.unwrap() == 3 && hi.unwrap() == 17, "3..=17")
    let (l2, h2) = known(goals.as_slice(), Lin.of(2))
    assert(l2.is_none() && h2.is_none(), "an unknown variable")
}

#[test]
fn proves_a_bound() {
    // 0 <= x, x <= 3 imply x <= 5.
    var facts = Vec(Lin).new()
    facts.push(Lin.of(7))
    facts.push(Lin.of(7).scale(-1).shift(3))
    let g = linear.Goal { facts, claim: Lin.of(7).scale(-1).shift(5) }
    let c = prove(g).unwrap()
    assert(linear.check(g, c).is_ok(), "checked")
    let h = linear.Goal { facts: g.facts.clone(), claim: Lin.of(7).scale(-1).shift(2) }
    assert(prove(h).is_err(), "not provable")
}
