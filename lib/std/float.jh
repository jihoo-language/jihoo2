// Floats as decimal digits, exactly. A finite float is f * 2^e for
// integers f and e; the digits come from big-integer arithmetic on that
// value (Steele and White's algorithm, as Burger and Dybvig state it), so
// they are correctly rounded and never depend on float arithmetic.
//
// `shortest` gives the fewest digits that read back as the same float;
// `exact` gives a chosen number of digits, rounded half to even.

// A float's IEEE 754 bits, and the float of given bits, in compiled code
// and at compile time alike: `x.to_bits()`, `f64.from_bits(b)`.
impl f64 {
    pub fn to_bits(self) -> u64 {
        var v = self
        unsafe { *(&v as *u64) }
    }

    pub fn from_bits(b: u64) -> f64 {
        var v = b
        unsafe { *(&v as *f64) }
    }
}

impl f32 {
    pub fn to_bits(self) -> u32 {
        var v = self
        unsafe { *(&v as *u32) }
    }

    pub fn from_bits(b: u32) -> f32 {
        var v = b
        unsafe { *(&v as *f32) }
    }
}

// A float taken apart.
pub struct Parts {
    pub negative: bool
    // NaN or an infinity: `f` is 0 for an infinity.
    pub special: bool
    pub f: u64
    pub e: i64
    // The precision in bits (53 or 24) and the smallest exponent.
    pub bits: i64
    pub e_min: i64
}

pub fn parts_f64(x: f64) -> Parts {
    let b = x.to_bits()
    let exp = ((b >> 52) & 0x7ff) as i64
    let mant = b & 0xfffffffffffff
    if exp == 0x7ff {
        return Parts {
            negative: b >> 63 == 1,
            special: true,
            f: mant,
            e: 0,
            bits: 53,
            e_min: -1074
        }
    }
    let f = if exp == 0 { mant } else { mant | 1 << 52 }
    let e = if exp == 0 { -1074 } else { exp - 1075 }
    Parts { negative: b >> 63 == 1, special: false, f: f, e: e, bits: 53, e_min: -1074 }
}

pub fn parts_f32(x: f32) -> Parts {
    let b = x.to_bits() as u64
    let exp = ((b >> 23) & 0xff) as i64
    let mant = b & 0x7fffff
    if exp == 0xff {
        return Parts { negative: b >> 31 == 1, special: true, f: mant, e: 0, bits: 24, e_min: -149 }
    }
    let f = if exp == 0 { mant } else { mant | 1 << 23 }
    let e = if exp == 0 { -149 } else { exp - 150 }
    Parts { negative: b >> 31 == 1, special: false, f: f, e: e, bits: 24, e_min: -149 }
}

// Decimal digits (0 to 9) and the exponent `k`: the value is
// 0.d1 d2 d3 ... * 10^k. Zero has no digits.
pub struct Digits {
    pub digits: Vec(u8)
    pub k: i64
}

// ---- unsigned big integers: little-endian 32-bit limbs ----

struct Big {
    d: Vec(u32)
}

impl Big {
    fn from(n: u64) -> Big {
        var d = Vec(u32).new()
        if n != 0 { d.push(n as u32) }
        if n >> 32 != 0 { d.push((n >> 32) as u32) }
        Big { d: d }
    }

    fn copy(self) -> Big {
        Big { d: self.d.clone() }
    }

    fn is_zero(self) -> bool {
        self.d.len() == 0
    }

    fn trim(inout self) {
        while self.d.len() > 0 && self.d[self.d.len() - 1] == 0 {
            self.d.pop()
        }
    }

    fn mul_small(inout self, m: u32) {
        var carry: u64 = 0
        for i in 0..self.d.len() {
            let t = self.d[i] as u64 * m as u64 + carry
            self.d[i] = t as u32
            carry = t >> 32
        }
        if carry != 0 { self.d.push(carry as u32) }
        self.trim()
    }

    fn mul_pow10(inout self, n: i64) {
        var left = n
        while left >= 9 {
            self.mul_small(1000000000)
            left -= 9
        }
        var m: u32 = 1
        for _ in 0..left { m *= 10 }
        if m != 1 { self.mul_small(m) }
    }

    // Times 2^n.
    fn shl(inout self, n: i64) {
        if self.is_zero() { return }
        let words = n / 32
        let bits = n % 32
        if bits != 0 {
            var carry: u32 = 0
            for i in 0..self.d.len() {
                let x = self.d[i]
                self.d[i] = (x << bits as u32) | carry
                carry = x >> (32 - bits) as u32
            }
            if carry != 0 { self.d.push(carry) }
        }
        if words > 0 {
            var d = Vec(u32).with_capacity(self.d.len() + words)
            for _ in 0..words { d.push(0) }
            for x in self.d { d.push(x) }
            self.d = d
        }
    }

    fn add(inout self, other: Big) {
        var carry: u64 = 0
        var i = 0
        while i < other.d.len() || carry != 0 {
            if i == self.d.len() { self.d.push(0) }
            let o: u64 = if i < other.d.len() { other.d[i] as u64 } else { 0 }
            let t = self.d[i] as u64 + o + carry
            self.d[i] = t as u32
            carry = t >> 32
            i += 1
        }
    }

    // `self - other`, which must not be negative.
    fn sub(inout self, other: Big) {
        var borrow: i64 = 0
        for i in 0..self.d.len() {
            let o: i64 = if i < other.d.len() { other.d[i] as i64 } else { 0 }
            var t = self.d[i] as i64 - o - borrow
            borrow = 0
            if t < 0 {
                t += 1 << 32
                borrow = 1
            }
            self.d[i] = t as u32
        }
        self.trim()
    }

    fn cmp(self, other: Big) -> i64 {
        if self.d.len() != other.d.len() {
            return if self.d.len() < other.d.len() { -1 } else { 1 }
        }
        var i = self.d.len()
        while i > 0 {
            i -= 1
            if self.d[i] != other.d[i] { return if self.d[i] < other.d[i] { -1 } else { 1 } }
        }
        0
    }
}

// `a + b` compared with `c`.
fn cmp_sum(a: Big, b: Big, c: Big) -> i64 {
    var t = a.copy()
    t.add(b)
    t.cmp(c)
}

// The next digit of r / s (below 10, since r < s before it was multiplied),
// leaving the remainder in r.
fn digit(inout r: Big, s: Big) -> u8 {
    var d: u8 = 0
    while r.cmp(s) >= 0 {
        r.sub(s)
        d += 1
    }
    d
}

fn bit_length(n: u64) -> i64 {
    var b = 0
    var x = n
    while x != 0 {
        b += 1
        x = x >> 1
    }
    b
}

// floor(log10(2^(n-1))), an estimate of k that the callers correct.
fn estimate(f: u64, e: i64) -> i64 {
    let n = e + bit_length(f) - 1
    // log10(2) < 78913 / 2^18
    if n >= 0 { n * 78913 >> 18 } else { 0 - ((0 - n) * 78913 >> 18) - 1 }
}

// The value as r / s.
fn ratio(f: u64, e: i64, inout r: Big, inout s: Big) {
    r = Big.from(f)
    s = Big.from(1)
    if e >= 0 { r.shl(e) } else { s.shl(0 - e) }
}

// The shortest digits that identify the float among its neighbors. A
// float with an even significand also owns the halfway points (they read
// back as it, under round half to even).
pub fn shortest(p: Parts) -> Digits {
    var out = Vec(u8).new()
    if p.f == 0 { return Digits { digits: out, k: 0 } }
    let even = p.f % 2 == 0
    // The gaps to the neighbors are 2^e each, except below a power of two.
    let lopsided = p.f == 1 << (p.bits - 1) as u64 && p.e > p.e_min
    var r = Big.from(p.f)
    var s = Big.from(1)
    var mp = Big.from(1)
    var mm = Big.from(1)
    if p.e >= 0 {
        r.shl(p.e)
        mp.shl(p.e)
        mm.shl(p.e)
    } else {
        s.shl(0 - p.e)
    }
    // Twice, so that the halfway points are integers.
    r.shl(1)
    s.shl(1)
    if lopsided {
        r.shl(1)
        s.shl(1)
        mp.shl(1)
    }
    var k = estimate(p.f, p.e)
    if k >= 0 {
        s.mul_pow10(k)
    } else {
        r.mul_pow10(0 - k)
        mp.mul_pow10(0 - k)
        mm.mul_pow10(0 - k)
    }
    // Correct k so that the upper bound is below 10^k, and at least 10^(k-1).
    loop {
        let c = cmp_sum(r, mp, s)
        if c > 0 || (even && c == 0) {
            s.mul_small(10)
            k += 1
        } else {
            break
        }
    }
    loop {
        var t = r.copy()
        t.add(mp)
        t.mul_small(10)
        let c = t.cmp(s)
        if c < 0 || (!even && c == 0) {
            r.mul_small(10)
            mp.mul_small(10)
            mm.mul_small(10)
            k -= 1
        } else {
            break
        }
    }
    loop {
        r.mul_small(10)
        mp.mul_small(10)
        mm.mul_small(10)
        let d = digit(&r, s)
        let low = if even { r.cmp(mm) <= 0 } else { r.cmp(mm) < 0 }
        let c = cmp_sum(r, mp, s)
        let high = if even { c >= 0 } else { c > 0 }
        if !low && !high {
            out.push(d)
            continue
        }
        if low && !high {
            out.push(d)
        } else if high && !low {
            out.push(d + 1)
        } else {
            var twice = r.copy()
            twice.shl(1)
            // Both are as short: the nearer, or on a tie the even one.
            let c = twice.cmp(s)
            out.push(if c < 0 || (c == 0 && d % 2 == 0) { d } else { d + 1 })
        }
        break
    }
    Digits { digits: out, k: k }
}

// `count` digits rounded half to even, from the first nonzero one when
// `fixed` is false; when it is true, as many as reach `count` digits after
// the decimal point (none if the value is smaller than half of the last).
pub fn exact(p: Parts, count: i64, fixed: bool) -> Digits {
    var out = Vec(u8).new()
    if p.f == 0 { return Digits { digits: out, k: 0 } }
    var r = Big.new_zero()
    var s = Big.new_zero()
    ratio(p.f, p.e, &r, &s)
    var k = estimate(p.f, p.e) + 1
    if k >= 0 { s.mul_pow10(k) } else { r.mul_pow10(0 - k) }
    // r / s in [0.1, 1)
    while r.cmp(s) >= 0 {
        s.mul_small(10)
        k += 1
    }
    loop {
        var t = r.copy()
        t.mul_small(10)
        if t.cmp(s) >= 0 { break }
        r = t
        k -= 1
    }
    let n = if fixed { k + count } else { count }
    if n < 0 { return Digits { digits: out, k: k } }
    for _ in 0..n {
        r.mul_small(10)
        out.push(digit(&r, s))
    }
    // Round by what is left, half to even.
    var twice = r.copy()
    twice.shl(1)
    let c = twice.cmp(s)
    let last_odd = out.len() > 0 && out[out.len() - 1] % 2 == 1
    if c > 0 || (c == 0 && last_odd) {
        var i = out.len()
        loop {
            if i == 0 {
                // All nines: 0.99 becomes 0.10 * 10.
                out.insert(0, 1)
                if !fixed { out.pop() }
                k += 1
                break
            }
            i -= 1
            if out[i] == 9 {
                out[i] = 0
            } else {
                out[i] += 1
                break
            }
        }
    }
    Digits { digits: out, k: k }
}

impl Big {
    fn new_zero() -> Big {
        Big { d: Vec(u32).new() }
    }
}

// ---- text ----

// The shortest text that reads back as the float: `1.5`, `100.0`, `-0.0`,
// `1e21`, `2.5e-7`, `NaN`, `inf`. Values from 1e-5 up to 1e16 are written
// out; others use an exponent.
pub fn write_shortest(inout out: String, p: Parts) {
    if special(&out, p) { return }
    if p.negative { out.push('-') }
    let d = shortest(p)
    if d.digits.len() == 0 {
        out.push_str("0.0")
        return
    }
    if d.k > -4 && d.k <= 16 {
        write_positional(&out, d, true)
    } else {
        write_scientific(&out, d)
    }
}

// Writes `NaN` or an infinity; whether it was one.
pub fn special(inout out: String, p: Parts) -> bool {
    if !p.special { return false }
    if p.f != 0 {
        out.push_str("NaN")
    } else {
        out.push_str(if p.negative { "-inf" } else { "inf" })
    }
    true
}

// The digits with the decimal point placed by k: `.0` is added to a whole
// number when `point` is set.
pub fn write_positional(inout out: String, d: Digits, point: bool) {
    let n = d.digits.len() as i64
    if d.k <= 0 {
        out.push_str("0.")
        for _ in 0..0 - d.k { out.push('0') }
        for x in d.digits { out.push('0' + x) }
        return
    }
    for i in 0..d.k {
        out.push(if i < n { '0' + d.digits[i] } else { '0' })
    }
    if n > d.k {
        out.push('.')
        for i in d.k..n { out.push('0' + d.digits[i]) }
    } else if point {
        out.push_str(".0")
    }
}

// `d.ddde-N`.
pub fn write_scientific(inout out: String, d: Digits) {
    if d.digits.len() == 0 {
        out.push_str("0e0")
        return
    }
    out.push('0' + d.digits[0])
    if d.digits.len() > 1 {
        out.push('.')
        for i in 1..d.digits.len() { out.push('0' + d.digits[i]) }
    }
    out.push('e')
    (d.k - 1).show(&out)
}

// Exactly `precision` digits after the decimal point.
pub fn write_fixed(inout out: String, p: Parts, precision: i64) {
    if special(&out, p) { return }
    if p.negative { out.push('-') }
    var d = exact(p, precision, true)
    if d.digits.len() == 0 { d.k = 0 }
    // Whole digits, then the fraction.
    if d.k <= 0 {
        out.push('0')
    } else {
        for i in 0..d.k { out.push('0' + d.digits[i]) }
    }
    if precision > 0 {
        out.push('.')
        var written = 0
        var i = if d.k > 0 { d.k } else { 0 }
        // Zeros between the point and the first digit.
        while written < precision && written < 0 - d.k {
            out.push('0')
            written += 1
        }
        while written < precision {
            out.push(if i < d.digits.len() { '0' + d.digits[i] } else { '0' })
            i += 1
            written += 1
        }
    }
}

// `precision` digits after the first, then the exponent: `1.50e3`.
pub fn write_exponent(inout out: String, p: Parts, precision: i64) {
    if special(&out, p) { return }
    if p.negative { out.push('-') }
    if p.f == 0 {
        out.push('0')
        if precision > 0 {
            out.push('.')
            for _ in 0..precision { out.push('0') }
        }
        out.push_str("e0")
        return
    }
    write_scientific(&out, exact(p, precision + 1, false))
}

fn fixed(x: f64, precision: i64) -> String {
    var s = String.new()
    write_fixed(&s, parts_f64(x), precision)
    s
}

fn exponent(x: f64, precision: i64) -> String {
    var s = String.new()
    write_exponent(&s, parts_f64(x), precision)
    s
}

fn short(x: f64) -> String {
    var s = String.new()
    write_shortest(&s, parts_f64(x))
    s
}

// ---- reading decimal text ----

// A float read from text, before its bits are put together: zero, an
// infinity, NaN, or `m * 2^e` with `m` below `2^bits`.
struct Read {
    negative: bool
    // 0 a finite value, 1 an infinity, 2 NaN.
    special: i64
    m: u64
    e: i64
}

// Digits kept: enough to decide any rounding of an f64 (767 significant
// digits can matter); the rest only say whether more was there.
const MAX_DIGITS: i64 = 800

fn lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

fn word_is(s: str, w: str) -> bool {
    if s.len != w.len { return false }
    for i in 0..s.len {
        if lower(s[i]) != w[i] { return false }
    }
    true
}

// The value of `[+-]digits[.digits][e[+-]digits]`, `inf`, `infinity` or
// `nan`, rounded to `bits` bits of precision (half to even) with `e_min`
// the exponent of the smallest subnormal; None for other text.
fn read_decimal(text: str, bits: i64, e_min: i64) -> Option(Read) {
    var i = 0
    var negative = false
    if text.len > 0 && (text[0] == '-' || text[0] == '+') {
        negative = text[0] == '-'
        i = 1
    }
    let rest = text[i..]
    if word_is(rest, "inf") || word_is(rest, "infinity") {
        return Some(Read { negative, special: 1, m: 0, e: 0 })
    }
    if word_is(rest, "nan") {
        return Some(Read { negative, special: 2, m: 0, e: 0 })
    }
    // The significant digits, and the power of ten they are scaled by.
    var digits = Vec(u8).new()
    var exp: i64 = 0
    var sticky = false
    var seen = false
    var point = false
    while i < text.len {
        let c = text[i]
        if c == '.' {
            if point { return None }
            point = true
        } else if c >= '0' && c <= '9' {
            seen = true
            if digits.len() == 0 && c == '0' {
                if point { exp -= 1 }
            } else if digits.len() < MAX_DIGITS {
                digits.push(c - '0')
                if point { exp -= 1 }
            } else {
                if c != '0' { sticky = true }
                if !point { exp += 1 }
            }
        } else {
            break
        }
        i += 1
    }
    if !seen { return None }
    if i < text.len {
        if text[i] != 'e' && text[i] != 'E' { return None }
        i += 1
        var eneg = false
        if i < text.len && (text[i] == '-' || text[i] == '+') {
            eneg = text[i] == '-'
            i += 1
        }
        if i == text.len { return None }
        var n: i64 = 0
        while i < text.len {
            let c = text[i]
            if c < '0' || c > '9' { return None }
            if n < 100000000 { n = n * 10 + (c - '0') as i64 }
            i += 1
        }
        exp = if eneg { exp - n } else { exp + n }
    }
    let zero = Read { negative, special: 0, m: 0, e: 0 }
    if digits.len() == 0 { return Some(zero) }
    // Far outside every float's range: no need to compute.
    let magnitude = exp + digits.len()
    if magnitude > 400 { return Some(Read { negative, special: 1, m: 0, e: 0 }) }
    if magnitude < -400 { return Some(zero) }
    // value = r / s, with a last digit 1 standing for what was dropped.
    var r = Big.from(0)
    for d in digits {
        r.mul_small(10)
        r.add(Big.from(d as u64))
    }
    if sticky {
        r.mul_small(10)
        r.add(Big.from(1))
        exp -= 1
    }
    var s = Big.from(1)
    if exp >= 0 { r.mul_pow10(exp) } else { s.mul_pow10(0 - exp) }
    // q = floor(r / (s * 2^k)) with bits + 1 bits (the last one the
    // rounding bit), or fewer for a subnormal: k >= e_min - 1.
    var k = big_bits(r) - big_bits(s) - bits - 1
    if k < e_min - 1 { k = e_min - 1 }
    var rr = r.copy()
    var ss = s.copy()
    loop {
        rr = r.copy()
        ss = s.copy()
        if k >= 0 { ss.shl(k) } else { rr.shl(0 - k) }
        var top = ss.copy()
        top.shl(bits + 1)
        if rr.cmp(top) >= 0 {
            k += 1
            continue
        }
        var low = ss.copy()
        low.shl(bits)
        if rr.cmp(low) < 0 && k > e_min - 1 {
            k -= 1
            continue
        }
        break
    }
    var q: u64 = 0
    var b = bits
    while b >= 0 {
        var t = ss.copy()
        t.shl(b)
        if rr.cmp(t) >= 0 {
            rr.sub(t)
            q = q | (1 as u64) << b as u64
        }
        b -= 1
    }
    let half = q & 1 == 1
    var m = q >> 1
    if half && (!rr.is_zero() || m & 1 == 1) { m += 1 }
    var e = k + 1
    if m == (1 as u64) << bits as u64 {
        m = m >> 1
        e += 1
    }
    Some(Read { negative, special: 0, m, e })
}

fn big_bits(x: Big) -> i64 {
    if x.d.len() == 0 { return 0 }
    (x.d.len() - 1) * 32 + bit_length(x.d[x.d.len() - 1] as u64)
}

// Powers of ten an f64 holds exactly.
fn exact_pow10(n: i64) -> f64 {
    var x = 1.0
    for _ in 0..n { x = x * 10.0 }
    x
}

// The f64 nearest the decimal text, as `str.parse_float` reads it.
pub fn parse_f64(text: str) -> Option(f64) {
    // Most numbers in text have few digits: an exact integer times or over
    // an exact power of ten rounds once, which is right.
    let fast = fast_f64(text)
    if fast.is_some() { return fast }
    let Some(x) = read_decimal(text, 53, -1074) else { return None }
    let sign: u64 = if x.negative { (1 as u64) << 63 } else { 0 }
    if x.special == 1 { return Some(f64.from_bits(sign | 0x7ff0000000000000)) }
    if x.special == 2 { return Some(f64.from_bits(0x7ff8000000000000)) }
    if x.m == 0 { return Some(f64.from_bits(sign)) }
    if x.m < (1 as u64) << 52 { return Some(f64.from_bits(sign | x.m)) }
    let biased = x.e + 1075
    if biased >= 0x7ff { return Some(f64.from_bits(sign | 0x7ff0000000000000)) }
    Some(f64.from_bits(sign | (biased as u64) << 52 | (x.m & 0xfffffffffffff)))
}

// `[+-]digits[.digits]` with at most 15 digits and no exponent... or None.
fn fast_f64(text: str) -> Option(f64) {
    var i = 0
    var negative = false
    if text.len > 0 && (text[0] == '-' || text[0] == '+') {
        negative = text[0] == '-'
        i = 1
    }
    var n: i64 = 0
    var count = 0
    var scale = 0
    var point = false
    var seen = false
    while i < text.len {
        let c = text[i]
        if c == '.' && !point {
            point = true
        } else if c >= '0' && c <= '9' {
            seen = true
            count += 1
            if count > 15 { return None }
            n = n * 10 + (c - '0') as i64
            if point { scale += 1 }
        } else {
            return None
        }
        i += 1
    }
    if !seen || scale > 22 { return None }
    let x = (n as f64) / exact_pow10(scale)
    // Times -1, which keeps the sign of zero (`0.0 - 0.0` is +0).
    Some(if negative { x * -1.0 } else { x })
}

// The f32 nearest the decimal text (rounded once, from the exact value).
pub fn parse_f32(text: str) -> Option(f32) {
    let Some(x) = read_decimal(text, 24, -149) else { return None }
    let sign: u32 = if x.negative { (1 as u32) << 31 } else { 0 }
    if x.special == 1 { return Some(f32.from_bits(sign | 0x7f800000)) }
    if x.special == 2 { return Some(f32.from_bits(0x7fc00000)) }
    if x.m == 0 { return Some(f32.from_bits(sign)) }
    let m = x.m as u32
    if m < (1 as u32) << 23 { return Some(f32.from_bits(sign | m)) }
    let biased = x.e + 150
    if biased >= 0xff { return Some(f32.from_bits(sign | 0x7f800000)) }
    Some(f32.from_bits(sign | (biased as u32) << 23 | (m & 0x7fffff)))
}

#[test]
fn taken_apart() {
    let one = parts_f64(1.0)
    assert(!one.negative && !one.special && one.f == 1 << 52 && one.e == -52, "1.0")
    let tiny = parts_f64(5e-324)
    assert(tiny.f == 1 && tiny.e == -1074, "the smallest subnormal")
    let inf = parts_f64(-1.0 / 0.0)
    assert(inf.special && inf.f == 0 && inf.negative, "-inf")
    assert(parts_f64(0.0 / 0.0).f != 0, "NaN")
    let half = parts_f32(0.5 as f32)
    assert(half.f == 1 << 23 && half.e == -24 && half.bits == 24, "f32")
    let d = shortest(parts_f64(123.25))
    assert(d.k == 3 && d.digits.len() == 5 && d.digits[0] == 1 && d.digits[4] == 5, "digits")
    assert(shortest(parts_f64(0.0)).digits.is_empty(), "zero has no digits")
}

#[test]
fn rounded_half_to_even() {
    // 0.125, 0.375 and 2.5 are exact, so these are ties.
    assert(fixed(0.125, 2) == "0.12" && fixed(0.375, 2) == "0.38", "ties")
    assert(fixed(2.5, 0) == "2" && fixed(3.5, 0) == "4" && fixed(0.5, 0) == "0", "whole ties")
    // 0.1 is a little more than a tenth; 2.675 a little less.
    assert(fixed(0.15, 1) == "0.1" && fixed(2.675, 2) == "2.67", "not ties")
    assert(fixed(9.996, 2) == "10.00" && fixed(-0.0006, 3) == "-0.001", "carried")
    assert(fixed(0.0004, 3) == "0.000" && fixed(1e-30, 2) == "0.00", "too small")
    assert(fixed(1e21, 1) == "1000000000000000000000.0", "large")
    assert(exponent(9.96, 1) == "1.0e1" && exponent(1234.5, 2) == "1.23e3", "exponent")
    assert(exponent(0.0, 2) == "0.00e0" && exponent(5e-324, 0) == "5e-324", "exponent ends")
}

#[test]
fn shortest_text() {
    assert(short(0.1) == "0.1" && short(100.0) == "100.0" && short(-0.0) == "-0.0", "plain")
    assert(short(1e16) == "1e16" && short(1e15) == "1000000000000000.0", "large")
    assert(short(0.0001) == "0.0001" && short(0.00001) == "1e-5", "small")
    assert(
        short(2.5e-7) == "2.5e-7" && short(1.7976931348623157e308) == "1.7976931348623157e308",
        "ends"
    )
    assert(short(1.0 / 0.0) == "inf" && short(0.0 / 0.0) == "NaN", "special")
}

#[test]
fn bits() {
    assert(1.0.to_bits() == 0x3ff0000000000000 && (-0.0).to_bits() == 1 << 63, "f64 bits")
    assert(f64.from_bits(0x7ff0000000000000) == 1.0 / 0.0, "infinity")
    assert(f64.from_bits(0.1.to_bits()) == 0.1, "round trip")
    assert((1.0 as f32).to_bits() == 0x3f800000, "f32 bits")
    assert(f32.from_bits(0x40490fdb) == (3.14159265 as f32), "f32 from bits")
}

#[test]
fn parses_floats() {
    assert(parse_f64("1.5") == Some(1.5) && parse_f64("-0.25") == Some(-0.25), "simple")
    assert(parse_f64("1e3") == Some(1000.0) && parse_f64("2.5E-3") == Some(0.0025), "exponent")
    assert(parse_f64(".5") == Some(0.5) && parse_f64("5.") == Some(5.0), "bare point")
    assert(parse_f64("0.1").unwrap().to_bits() == 0.1.to_bits(), "0.1")
    assert(parse_f64("0.30000000000000004") == Some(0.1 + 0.2), "shortest of 0.1 + 0.2")
    assert(parse_f64("1.7976931348623157e308").unwrap().to_bits() == 0x7fefffffffffffff, "max")
    assert(parse_f64("1.8e308").unwrap() == 1.0 / 0.0, "overflow")
    assert(parse_f64("4.9e-324").unwrap().to_bits() == 1, "least subnormal")
    assert(parse_f64("2.4e-324").unwrap().to_bits() == 0, "below half of it")
    assert(parse_f64("2.5e-324").unwrap().to_bits() == 1, "above half of it")
    assert(
        parse_f64("2.2250738585072014e-308").unwrap().to_bits() == 0x10000000000000,
        "least normal"
    )
    assert(parse_f64("-0").unwrap().to_bits() == (1 as u64) << 63, "negative zero")
    assert(parse_f64("inf") == Some(1.0 / 0.0) && parse_f64("-Infinity") == Some(-1.0 / 0.0), "inf")
    let nan = parse_f64("NaN").unwrap()
    assert(nan != nan, "nan")
    // Halfway between 1 and the next float, and just above it.
    assert(
        parse_f64("1.00000000000000011102230246251565404236316680908203125") == Some(1.0),
        "half to even"
    )
    let above = parse_f64("1.000000000000000111022302462515654042363166809082031251").unwrap()
    assert(above.to_bits() == 0x3ff0000000000001, "just above half")
    for bad in ["", "-", ".", "e5", "1e", "1e+", "1.2.3", "1x", "--1", "in"] {
        assert(parse_f64(bad).is_none(), "rejected")
    }
    assert(parse_f32("3.14159265") == Some(3.14159265 as f32), "f32")
    assert(parse_f32("1e39").unwrap() == (1.0 as f32) / (0.0 as f32), "f32 overflow")
    assert(parse_f32("1.4e-45").unwrap().to_bits() == 1, "f32 least subnormal")
}

#[test]
fn reads_what_it_writes() {
    // Every float printed shortest reads back as itself.
    var x: u64 = 0x123456789abcdef
    for _ in 0..2000 {
        x = x *% 6364136223846793005 +% 1442695040888963407
        let f = f64.from_bits(x)
        if f != f { continue }
        var s = String.new()
        f.show(&s)
        let back = parse_f64(s.as_str()).unwrap()
        assert(back.to_bits() == f.to_bits() || (f == 0.0 && back == 0.0), "round trip")
    }
}
