// Vec(T): a growable array, owned.

import std.mem

// Never negative (docs/language/contracts.md#type-invariants). Bytes
// borrowed from a literal (`String.from_static`) have `cap` 0 and `len`
// above it.
pub struct Vec(T: type)
    invariant 0 <= self.len && 0 <= self.cap
{
    ptr: *T
    len: i64
    cap: i64
}

impl(T: type) Vec(T) {
    pub fn new() -> Vec(T)
        ensures result.len == 0
    {
        Vec(T) { ptr: null, len: 0, cap: 0 }
    }

    pub fn with_capacity(n: i64) -> Vec(T)
        ensures result.len == 0 && n <= result.cap
    {
        var v = Vec(T).new()
        v.reserve(n)
        v
    }

    pub fn len(self) -> i64
        ensures result == self.len
    {
        self.len
    }

    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    pub fn capacity(self) -> i64 {
        self.cap
    }

    // Room for at least n more values.
    pub fn reserve(inout self, n: i64)
        ensures self.len == old(self.len) && self.len + n <= self.cap
    {
        // Both are not negative, so the difference cannot overflow.
        if n <= self.cap - self.len {
            return
        }
        // Less than nothing is nothing: borrowed bytes (`cap` below `len`)
        // are still copied whole.
        let more = if n < 0 { 0 } else { n }
        // Checked here, not by `+`, which wraps in `--release` builds: a sum
        // of two numbers that are not negative wraps below the first.
        let need = self.len +% more
        if need < self.len { panic("capacity overflow") }
        var c = if self.cap == 0 { 4 } else { self.cap * 2 }
        if c < need {
            c = need
        }
        // Borrowed bytes (a `String` from a literal, `cap` 0 under `len`)
        // are copied; the others move. Not a test of `cap == 0 && len > 0`,
        // whose failing branch would be a disjunction for the verifier.
        unsafe {
            if self.cap < self.len {
                let p = mem.alloc(T, c)
                mem_copy(p, self.ptr, self.len)
                self.ptr = p
            } else {
                self.ptr = mem.realloc(T, self.ptr, self.cap, c)
            }
        }
        self.cap = c
    }

    pub fn push(inout self, sink x: T)
        ensures self.len == old(self.len) + 1
    {
        // Above `cap` when the bytes are borrowed (`String.from_static`).
        if self.len >= self.cap {
            self.reserve(1)
        }
        unsafe {
            write(self.ptr + self.len, x)
        }
        self.len += 1
    }

    pub fn pop(inout self) -> Option(T)
        ensures old(self.len) - 1 <= self.len && self.len <= old(self.len)
    {
        if self.len == 0 {
            return None
        }
        self.len -= 1
        unsafe { Some(read(self.ptr + self.len)) }
    }

    pub fn index(self, i: i64) -> ref T {
        // One unsigned comparison checks both ends.
        if (i as u64) >= (self.len as u64) {
            panic("index out of bounds")
        }
        unsafe { *(self.ptr + i) }
    }

    pub fn index_mut(inout self, i: i64) -> inout T {
        if (i as u64) >= (self.len as u64) {
            panic("index out of bounds")
        }
        unsafe { *(self.ptr + i) }
    }

    pub fn first(self) -> Option(ref T) {
        if self.len == 0 { None } else { Some(self.index(0)) }
    }

    pub fn last(self) -> Option(ref T) {
        if self.len == 0 { None } else { Some(self.index(self.len - 1)) }
    }

    pub fn as_slice(self) -> [T]
        ensures result.len == self.len
    {
        unsafe { make_slice(self.ptr, self.len) }
    }

    pub fn insert(inout self, i: i64, sink x: T)
        ensures self.len == old(self.len) + 1
    {
        if i < 0 || i > self.len {
            panic("insert index out of bounds")
        }
        // Above `cap` when the bytes are borrowed (`String.from_static`).
        if self.len >= self.cap {
            self.reserve(1)
        }
        unsafe {
            mem_copy(self.ptr + i + 1, self.ptr + i, self.len - i)
            write(self.ptr + i, x)
        }
        self.len += 1
    }

    pub fn remove(inout self, i: i64) -> T
        ensures self.len == old(self.len) - 1
    {
        if i < 0 || i >= self.len {
            panic("remove index out of bounds")
        }
        unsafe {
            let x = read(self.ptr + i)
            mem_copy(self.ptr + i, self.ptr + i + 1, self.len - i - 1)
            self.len -= 1
            x
        }
    }

    // Removes the value at `i` and puts the last one in its place: no
    // shifting, but the order changes.
    pub fn swap_remove(inout self, i: i64) -> T {
        if i < 0 || i >= self.len {
            panic("swap_remove index out of bounds")
        }
        unsafe {
            let x = read(self.ptr + i)
            self.len -= 1
            if i != self.len {
                write(self.ptr + i, read(self.ptr + self.len))
            }
            x
        }
    }

    // Keeps the values `keep` holds of, in order, and drops the others.
    pub fn retain(inout self, keep: fn(T) -> bool) {
        let n = self.len
        var w = 0
        for r in 0..n {
            unsafe {
                if keep(*(self.ptr + r)) {
                    if w != r {
                        write(self.ptr + w, read(self.ptr + r))
                    }
                    w += 1
                } else {
                    mem.drop_at(T, self.ptr + r)
                }
            }
        }
        self.len = w
    }

    // The values from `at` on, moved to a new `Vec`; this one keeps the
    // ones before.
    pub fn split_off(inout self, at: i64) -> Vec(T) {
        if at < 0 || at > self.len {
            panic("split_off index out of bounds")
        }
        let n = self.len - at
        var out = Vec(T).with_capacity(n)
        unsafe {
            mem_copy(out.ptr, self.ptr + at, n)
        }
        out.len = n
        self.len = at
        out
    }

    pub fn swap(inout self, i: i64, j: i64) {
        if i < 0 || i >= self.len || j < 0 || j >= self.len {
            panic("swap index out of bounds")
        }
        if i != j {
            unsafe {
                let t = read(self.ptr + i)
                write(self.ptr + i, read(self.ptr + j))
                write(self.ptr + j, t)
            }
        }
    }

    // Drops the values from n on (all of them when n is negative).
    pub fn truncate(inout self, n: i64) {
        while self.len > n && self.len > 0
            invariant 0 <= self.len
        {
            self.len -= 1
            unsafe { mem.drop_at(T, self.ptr + self.len) }
        }
    }

    pub fn clear(inout self) {
        self.truncate(0)
    }

    pub fn extend(inout self, sink other: Vec(T)) {
        self.reserve(other.len)
        unsafe {
            mem_copy(self.ptr + self.len, other.ptr, other.len)
            self.len += other.len
            mem.dealloc(T, other.ptr, other.cap)
            forget(other)
        }
    }

    pub fn reverse(inout self) {
        var i = 0
        var j = self.len - 1
        while i < j {
            self.swap(i, j)
            i += 1
            j -= 1
        }
    }

    pub fn iter(self) -> Iter(T) {
        Iter(T) { ptr: self.ptr, end: unsafe { self.ptr + self.len } }
    }

    // Gives the values away one by one: `for x in v.into_iter()` owns each
    // `x`, where `for x in v` borrows it.
    pub fn into_iter(sink self) -> IntoIter(T) {
        IntoIter(T) { v: self, next: 0 }
    }
}

// Borrows the values of a `Vec` or slice one by one.
#[view]
pub struct Iter(T: type) {
    ptr: *T
    end: *T
}

impl(T: type) Iterator for Iter(T) {
    type Item = ref T

    fn next(inout self) -> Option(ref T) {
        if self.ptr == self.end {
            return None
        }
        unsafe {
            let p = self.ptr
            self.ptr = self.ptr + 1
            Some(*p)
        }
    }
}

impl(T: type) Iter(T) {
    // The values not yet given, from the last down: `for x in v.iter().rev()`.
    pub fn rev(sink self) -> RevIter(T) {
        RevIter(T) { start: self.ptr, ptr: self.end }
    }
}

// Borrows the values of a `Vec` or slice one by one, from the last.
#[view]
pub struct RevIter(T: type) {
    start: *T
    ptr: *T
}

impl(T: type) Iterator for RevIter(T) {
    type Item = ref T

    fn next(inout self) -> Option(ref T) {
        if self.ptr == self.start {
            return None
        }
        unsafe {
            self.ptr = self.ptr - 1
            Some(*self.ptr)
        }
    }
}

// Owns a `Vec` and gives its values away one by one.
pub struct IntoIter(T: type) {
    v: Vec(T)
    next: i64
}

impl(T: type) Iterator for IntoIter(T) {
    type Item = T

    fn next(inout self) -> Option(T) {
        if self.next == self.v.len {
            return None
        }
        self.next += 1
        Some(unsafe { read(self.v.ptr + self.next - 1) })
    }
}

impl(T: type) Drop for IntoIter(T) {
    // Drops the values not given away; the `Vec` then frees its memory.
    fn drop(inout self) {
        if needs_drop(T) {
            while self.next < self.v.len {
                unsafe { mem.drop_at(T, self.v.ptr + self.next) }
                self.next += 1
            }
        }
        self.v.len = 0
    }
}

impl(T: Eq) [T] {
    pub fn contains(self, x: T) -> bool {
        for y in self {
            if y == x {
                return true
            }
        }
        false
    }
}

impl(T: Eq) Vec(T) {
    pub fn contains(self, x: T) -> bool {
        self.as_slice().contains(x)
    }

    // Drops each value equal to the one before it: a sorted `Vec` keeps
    // one of each.
    pub fn dedup(inout self) {
        if self.len < 2 {
            return
        }
        let n = self.len
        var w = 1
        for r in 1..n {
            unsafe {
                if (*(self.ptr + r)).eq(*(self.ptr + w - 1)) {
                    mem.drop_at(T, self.ptr + r)
                } else {
                    if w != r {
                        write(self.ptr + w, read(self.ptr + r))
                    }
                    w += 1
                }
            }
        }
        self.len = w
    }
}

impl(T: type) [T] {
    // The parts of `n` values that start at each position, overlapping:
    // `[1, 2, 3].windows(2)` gives `[1, 2]`, `[2, 3]`. Panics if `n` is not
    // positive.
    pub fn windows(self, n: i64) -> Windows(T) {
        if n <= 0 {
            panic("windows needs a positive size")
        }
        Windows(T) { xs: self, n, at: 0 }
    }

    // The parts of `n` values one after another, the last one shorter if
    // `n` does not divide the length. Panics if `n` is not positive.
    pub fn chunks(self, n: i64) -> Chunks(T) {
        if n <= 0 {
            panic("chunks needs a positive size")
        }
        Chunks(T) { xs: self, n, at: 0 }
    }
}

#[view]
pub struct Windows(T: type) {
    xs: [T]
    n: i64
    at: i64
}

impl(T: type) Iterator for Windows(T) {
    type Item = [T]

    fn next(inout self) -> Option([T]) {
        if self.at + self.n > self.xs.len {
            return None
        }
        let i = self.at
        self.at += 1
        Some(self.xs[i..i + self.n])
    }
}

#[view]
pub struct Chunks(T: type) {
    xs: [T]
    n: i64
    at: i64
}

impl(T: type) Iterator for Chunks(T) {
    type Item = [T]

    fn next(inout self) -> Option([T]) {
        if self.at >= self.xs.len {
            return None
        }
        let i = self.at
        var end = i + self.n
        if end > self.xs.len {
            end = self.xs.len
        }
        self.at = end
        Some(self.xs[i..end])
    }
}

impl(T: Clone) Vec(T) {
    // Copies of the values pushed at the end.
    pub fn extend_from_slice(inout self, xs: [T]) {
        self.reserve(xs.len)
        for x in xs {
            self.push(x.clone())
        }
    }
}

impl(T: Clone) [T] {
    // A `Vec` of copies of the values.
    pub fn to_vec(self) -> Vec(T) {
        var v = Vec(T).with_capacity(self.len)
        for x in self { v.push(x.clone()) }
        v
    }
}

impl(T: Clone) Vec(T) {
    // n copies of x (none when n is negative).
    pub fn filled(n: i64, x: T) -> Vec(T) {
        var v = Vec(T).with_capacity(n)
        var i = 0
        while i < n
            invariant 0 <= i && i <= v.cap && n <= v.cap
        {
            unsafe { write(v.ptr + i, x.clone()) }
            i += 1
        }
        v.len = i
        v
    }

    // Grows to n values with copies of x, or drops the values past n.
    pub fn resize(inout self, n: i64, x: T) {
        if n <= self.len {
            self.truncate(n)
            return
        }
        self.reserve(n - self.len)
        while self.len < n
            invariant 0 <= self.len && 0 <= self.cap
        {
            unsafe { write(self.ptr + self.len, x.clone()) }
            self.len += 1
        }
    }
}

impl(T: type) Drop for Vec(T) {
    fn drop(inout self) {
        if needs_drop(T) {
            var i = 0
            while i < self.len {
                unsafe { mem.drop_at(T, self.ptr + i) }
                i += 1
            }
        }
        unsafe { mem.dealloc(T, self.ptr, self.cap) }
    }
}

impl(T: Clone) Clone for Vec(T) {
    fn clone(self) -> Vec(T) {
        var v = Vec(T).with_capacity(self.len)
        for x in self.as_slice() {
            v.push(x.clone())
        }
        v
    }
}

// `[1, 2, 3]`.
impl(T: Show) Show for Vec(T) {
    fn show(self, inout out: String) {
        out.push('[')
        for i in 0..self.len {
            if i > 0 {
                out.push_str(", ")
            }
            self[i].show(&out)
        }
        out.push(']')
    }
}

// `[1, 2, 3]`, as a `Vec` prints.
impl(T: Show) Show for [T] {
    fn show(self, inout out: String) {
        out.push('[')
        for i, x in self {
            if i > 0 {
                out.push_str(", ")
            }
            x.show(&out)
        }
        out.push(']')
    }
}

// The same length, and equal values in order.
impl(T: Eq) Eq for [T] {
    fn eq(self, other: [T]) -> bool {
        if self.len != other.len {
            return false
        }
        for i, x in self {
            if !x.eq(other[i]) {
                return false
            }
        }
        true
    }
}

impl(T: Show, comptime N: i64) Show for [T; N] {
    fn show(self, inout out: String) {
        self[..].show(&out)
    }
}

impl(T: Eq, comptime N: i64) Eq for [T; N] {
    fn eq(self, other: [T; N]) -> bool {
        self[..].eq(other[..])
    }
}

impl(T: Eq) Eq for Vec(T) {
    fn eq(self, other: Vec(T)) -> bool {
        if self.len != other.len {
            return false
        }
        var i = 0
        while i < self.len {
            if !self[i].eq(other[i]) {
                return false
            }
            i += 1
        }
        true
    }
}

impl(T: type) Default for Vec(T) {
    fn default() -> Vec(T) {
        Vec(T).new()
    }
}

#[test]
fn push_pop_and_grow() {
    var v = Vec(i64).new()
    assert(v.is_empty() && v.pop().is_none(), "empty")
    for i in 0..100 {
        v.push(i * i)
    }
    assert(v.len() == 100 && v.capacity() >= 100, "100 elements")
    assert(
        v[99] == 9801 && v.first().unwrap().clone() == 0 && v.last().unwrap().clone() == 9801,
        "ends"
    )
    assert(v.pop() == Some(9801) && v.len() == 99, "pop")
    v[0] = 7
    v[1] += 1
    assert(v[0] == 7 && v[1] == 2, "index_mut")
}

#[test]
fn insert_remove_and_swap() {
    var v = Vec(i64).new()
    for i in 0..5 {
        v.push(i)
    }
    v.insert(0, 10)
    v.insert(6, 20)
    v.insert(3, 30)
    // 10 0 1 30 2 3 4 20
    assert(v.len() == 8 && v[0] == 10 && v[3] == 30 && v[7] == 20, "inserted")
    assert(v.remove(3) == 30 && v.remove(0) == 10, "removed")
    v.swap(0, 5)
    assert(v[0] == 20 && v[5] == 0, "swapped")
    v.reverse()
    assert(v[0] == 0 && v[5] == 20, "reversed")
    v.truncate(2)
    assert(v.len() == 2 && v[1] == 4, "truncated")
    v.clear()
    assert(v.is_empty(), "cleared")
}

#[test]
fn owned_elements_move_and_drop() {
    var v = Vec(String).new()
    for i in 0..20 {
        v.push(i.to_string())
    }
    var w = Vec(String).new()
    w.push(String.from("x"))
    w.extend(v)
    assert(w.len() == 21 && w[0] == "x" && w[20] == "19", "extended")
    let s = w.remove(1)
    assert(s == "0" && w[1] == "1", "moved out")
    w.resize(3, String.from("y"))
    w.resize(5, String.from("z"))
    assert(w.len() == 5 && w[2] == "2" && w[3] == "z" && w[4] == "z", "resized")
    var total = 0
    for x in w.into_iter() {
        total += x.len()
    }
    assert(total == 5, "into_iter")
}

#[test]
fn filled_and_slices() {
    let v = Vec.filled(4, 3 as u8)
    let s = v.as_slice()
    assert(s.len == 4 && s[3] == 3, "filled")
    var n = 0
    for x in v.iter() {
        n += x as i64
    }
    assert(n == 12, "iter")
}

#[test]
fn contains_and_to_vec() {
    let v = [3, 1, 2].to_vec()
    assert(v.contains(2) && !v.contains(7) && v.as_slice()[1..].contains(1), "contains")
    var names = Vec(String).new()
    names.push(String.from("x"))
    assert(names.contains(String.from("x")) && !names.contains(String.from("y")), "strings")
    let copy = names.as_slice().to_vec()
    assert(copy == names && Vec(i64).new().as_slice().to_vec().is_empty(), "to_vec")
}

#[test]
fn removes_retains_and_splits() {
    var v = [1, 2, 3, 4, 5, 6].to_vec()
    assert(v.swap_remove(1) == 2 && v == [1, 6, 3, 4, 5].to_vec(), "swap_remove")
    assert(v.swap_remove(4) == 5 && v.len() == 4, "swap_remove last")
    v.retain(fn(x) { x % 2 == 0 })
    assert(v == [6, 4].to_vec(), "retain")
    var w = [1, 2, 3, 4, 5].to_vec()
    let tail = w.split_off(3)
    assert(w == [1, 2, 3].to_vec() && tail == [4, 5].to_vec(), "split_off")
    assert(w.split_off(3).is_empty() && w.split_off(0).len() == 3 && w.is_empty(), "split ends")
    var d = [1, 1, 2, 3, 3, 3, 1].to_vec()
    d.dedup()
    assert(d == [1, 2, 3, 1].to_vec(), "dedup")
    var e = Vec(i64).new()
    e.dedup()
    e.extend_from_slice([7, 8][..])
    assert(e == [7, 8].to_vec(), "extend_from_slice")
}

#[test]
fn owned_values_retained_and_deduped() {
    var v = Vec(String).new()
    for s in ["a", "a", "b", "c", "c"] {
        v.push(String.from(s))
    }
    v.dedup()
    assert(v.len() == 3 && v[2] == "c", "dedup strings")
    v.retain(fn(s) { s != "b" })
    assert(v.len() == 2 && v[1] == "c", "retain strings")
    let gone = v.swap_remove(0)
    assert(gone == "a" && v[0] == "c", "swap_remove string")
}

#[test]
fn windows_and_chunks() {
    let xs = [1, 2, 3, 4, 5]
    var sums = Vec(i64).new()
    for w in xs.windows(2) {
        sums.push(w[0] + w[1])
    }
    assert(sums == [3, 5, 7, 9].to_vec(), "windows")
    var n = 0
    for _ in xs.windows(6) {
        n += 1
    }
    assert(n == 0, "windows longer than the slice")
    var lens = Vec(i64).new()
    for c in xs.chunks(2) {
        lens.push(c.len)
    }
    assert(lens == [2, 2, 1].to_vec(), "chunks")
    var none = 0
    for _ in Vec(i64).new().as_slice().chunks(3) {
        none += 1
    }
    assert(none == 0, "chunks of nothing")
}

#[test]
fn slices_and_arrays_show_and_compare() {
    let xs = [1, 2, 3]
    var a = String.new()
    xs.show(&a)
    var b = String.new()
    xs[1..].show(&b)
    var c = String.new()
    xs[..0].show(&c)
    assert(a == "[1, 2, 3]" && b == "[2, 3]" && c == "[]", "show")
    assert(xs == [1, 2, 3] && xs != [1, 2, 4], "arrays")
    assert(xs[..2] == [1, 2][..] && xs[..2] != xs[1..], "slices")
    let words = ["a", "b"]
    var d = String.new()
    words.show(&d)
    assert(d == "[a, b]", "strings inside print bare")
}
