// Files, whole. Failures are `os.Error`s.

import std.os
import std.sys
import std.env

// The whole file as text. Its bytes are not checked to be UTF-8; see
// `std.utf8.validate`.
pub fn read_file(path: str) -> Result(String, os.Error) {
    Ok(String { bytes: read_bytes(path)? })
}

// The whole file.
pub fn read_bytes(path: str) -> Result(Vec(u8), os.Error) {
    var f = os.File.open(path)?
    var out = Vec(u8).new()
    f.read_to_end(&out)?
    Ok(out)
}

// Replaces the file's contents with `text`, creating it if missing.
pub fn write_file(path: str, text: str) -> Result((), os.Error) {
    write_bytes(path, text.as_bytes())
}

pub fn write_bytes(path: str, data: [u8]) -> Result((), os.Error) {
    var f = os.File.create(path)?
    f.write_all(data)
}

// Adds `data` at the file's end, creating it if missing.
pub fn append_bytes(path: str, data: [u8]) -> Result((), os.Error) {
    var f = os.File.append(path)?
    f.write_all(data)
}

pub fn remove_file(path: str) -> Result((), os.Error) {
    check_path(path)?
    done(sys.unlink_raw(path))
}

// A new directory, readable and writable by everyone the umask allows;
// `AlreadyExists` if there is something at `path`.
pub fn create_dir(path: str) -> Result((), os.Error) {
    check_path(path)?
    done(sys.mkdir_raw(path, 0o777))
}

// Removes a directory, which must be empty.
pub fn remove_dir(path: str) -> Result((), os.Error) {
    check_path(path)?
    done(sys.rmdir_raw(path))
}

// A path with a zero byte cannot reach the system.
fn check_path(path: str) -> Result((), os.Error) {
    for b in path {
        if b == 0 { return Err(os.Error.InvalidInput) }
    }
    Ok(())
}

fn done(r: i64) -> Result((), os.Error) {
    if r < 0 { return Err(os.Error.from_code((0 - r) as i32)) }
    Ok(())
}

// The names in a directory, sorted, without `.` and `..`.
pub fn read_dir(path: str) -> Result(Vec(String), os.Error) {
    let dir = os.File.open(path)?
    var names = Vec(String).new()
    var buf = [0 as u8; 8192]
    loop {
        let n = unsafe { sys.read_dir_raw(dir.fd(), &buf[0], 8192) }
        if n == -4 { continue }
        if n < 0 { return Err(os.Error.from_code((0 - n) as i32)) }
        if n == 0 {
            break
        }
        // Each record: inode (8 bytes), offset (8), its length (2), type
        // (1), then the name and a 0.
        var at = 0
        while at < n {
            let size = buf[at + 16] as i64 | (buf[at + 17] as i64) << 8
            var end = at + 19
            while buf[end] != 0 {
                end += 1
            }
            let name = unsafe { make_str(&buf[at + 19], end - at - 19) }
            if name != "." && name != ".." {
                names.push(name.to_string())
            }
            at += size
        }
    }
    sort(&names)
    Ok(names)
}

// A directory of its own for a test, empty, under `$TMPDIR` or `/tmp`.
fn scratch(name: str) -> String {
    let base = match env.get("TMPDIR") {
        Some(t) => t
        None => "/tmp"
    }
    let dir = base + "/jihoo-std-fs-" + name
    match read_dir(dir.as_str()) {
        Ok(names) => {
            for n in names {
                let p = dir.as_str() + "/" + n.as_str()
                if remove_file(p.as_str()).is_err() { remove_dir(p.as_str()).unwrap() }
            }
            remove_dir(dir.as_str()).unwrap()
        }
        Err(_) => {}
    }
    create_dir(dir.as_str()).unwrap()
    dir
}

#[test]
fn files_written_read_and_removed() {
    let dir = scratch("files")
    let path = dir.as_str() + "/a.txt"
    let p = path.as_str()
    write_file(p, "héllo\n").unwrap()
    assert(read_file(p).unwrap() == "héllo\n", "written then read")
    append_bytes(p, "more".as_bytes()).unwrap()
    let bytes = read_bytes(p).unwrap()
    assert(bytes.len() == 11 && bytes[7] == 'm', "appended")
    write_bytes(p, [1 as u8, 0, 2][..]).unwrap()
    assert(read_bytes(p).unwrap().len() == 3, "replaced, zero bytes kept")
    write_file(p, "").unwrap()
    assert(read_file(p).unwrap().is_empty(), "emptied")
    remove_file(p).unwrap()
    assert(read_file(p).is_err() && remove_file(p) == Err(os.Error.NotFound), "removed")
    assert(remove_file("a\0b") == Err(os.Error.InvalidInput), "zero byte")
    remove_dir(dir.as_str()).unwrap()
}

#[test]
fn directories() {
    let dir = scratch("dirs")
    let d = dir.as_str()
    assert(read_dir(d).unwrap().is_empty(), "new and empty")
    assert(create_dir(d) == Err(os.Error.AlreadyExists), "exists")
    // Enough names for several reads of the directory.
    for i in 0..300 {
        write_file((d + "/f" + i.to_string().as_str()).as_str(), "x").unwrap()
    }
    create_dir((d + "/sub").as_str()).unwrap()
    let names = read_dir(d).unwrap()
    assert(
        names.len() == 301 && names[0] == "f0" && names[1] == "f1" && names[2] == "f10",
        "sorted"
    )
    assert(names[300] == "sub", "the subdirectory too")
    assert(remove_dir(d) == Err(os.Error.NotEmpty), "not empty")
    assert(remove_dir((d + "/f0").as_str()) == Err(os.Error.NotADirectory), "a file")
    assert(read_dir((d + "/f0").as_str()) == Err(os.Error.NotADirectory), "read a file")
    remove_dir((d + "/sub").as_str()).unwrap()
    for i in 0..300 {
        remove_file((d + "/f" + i.to_string().as_str()).as_str()).unwrap()
    }
    remove_dir(d).unwrap()
    assert(read_dir(d) == Err(os.Error.NotFound), "removed")
}
