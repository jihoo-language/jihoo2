// What LLVM calls for 128-bit integers that the machine cannot do in a few
// instructions: division, remainder and conversions to and from floats. A
// native program gets these from the C runtime (libgcc); a freestanding one
// from here. They use no 128-bit division or 128-bit float conversion
// themselves, which would call back into them.
//
// Likewise the C math functions LLVM calls for float `%` (`fmod`) and, where
// the machine has no instruction for them (x86-64 before SSE4.1), the
// builtins `floor`, `ceil`, `trunc` and `round`, which libm gives native
// programs. They work on the bits, without float `%` or those builtins.

const TWO_64: f64 = 18446744073709551616.0

fn f64_bits(x: f64) -> u64 {
    var v = x
    unsafe { *(&v as *u64) }
}

fn f64_of_bits(b: u64) -> f64 {
    var v = b
    unsafe { *(&v as *f64) }
}

// 2^k, exactly, for 0 <= k < 1024.
fn pow2(k: i64) -> f64 {
    f64_of_bits(((1023 + k) as u64) << 52)
}

// The number of bits `a` needs.
fn width(a: u128) -> i64 {
    var n = 0
    var x = a
    while x != 0 {
        x = x >> 1
        n += 1
    }
    n
}

fn udivmod(n: u128, d: u128) -> (u128, u128) {
    if n >> 64 == 0 && d >> 64 == 0 {
        let a = n as u64
        let b = d as u64
        return ((a / b) as u128, (a % b) as u128)
    }
    var q: u128 = 0
    var r: u128 = 0
    var i = width(n) - 1
    while i >= 0 {
        r = (r << 1) | ((n >> i) & 1)
        if r >= d {
            r = r -% d
            q = q | (1 << i)
        }
        i -= 1
    }
    (q, r)
}

fn abs(a: i128) -> u128 {
    if a < 0 { 0 -% (a as u128) } else { a as u128 }
}

export fn __udivti3(n: u128, d: u128) -> u128 {
    udivmod(n, d).0
}

export fn __umodti3(n: u128, d: u128) -> u128 {
    udivmod(n, d).1
}

export fn __divti3(a: i128, b: i128) -> i128 {
    let q = udivmod(abs(a), abs(b)).0
    if (a < 0) != (b < 0) { (0 -% q) as i128 } else { q as i128 }
}

// The remainder has the sign of the dividend, as in C.
export fn __modti3(a: i128, b: i128) -> i128 {
    let r = udivmod(abs(a), abs(b)).1
    if a < 0 { (0 -% r) as i128 } else { r as i128 }
}

// `a` rounded to a float: its top 64 bits, with a sticky bit for the rest
// so that the machine's 64-bit conversion rounds as the whole value would,
// then scaled exactly.
fn top64(a: u128) -> (u64, i64) {
    let k = width(a) - 64
    if k <= 0 {
        return (a as u64, 0)
    }
    var m = (a >> k) as u64
    if a & ((1 << k) - 1) != 0 {
        m = m | 1
    }
    (m, k)
}

export fn __floatuntidf(a: u128) -> f64 {
    let (m, k) = top64(a)
    (m as f64) * pow2(k)
}

export fn __floattidf(a: i128) -> f64 {
    let f = __floatuntidf(abs(a))
    if a < 0 { 0.0 - f } else { f }
}

export fn __floatuntisf(a: u128) -> f32 {
    let (m, k) = top64(a)
    (m as f32) * (pow2(k) as f32)
}

export fn __floattisf(a: i128) -> f32 {
    let f = __floatuntisf(abs(a))
    if a < 0 { 0.0 - f } else { f }
}

// The integer part of `x`, saturated to [0, 2^128).
export fn __fixunsdfti(x: f64) -> u128 {
    if !(x >= 1.0) {
        return 0
    }
    if x >= TWO_64 * TWO_64 {
        return 0 -% (1 as u128)
    }
    let b = f64_bits(x)
    let e = ((b >> 52) & 0x7ff) as i64 - 1075
    let m = ((b & 0xfffffffffffff) | 0x10000000000000) as u128
    if e >= 0 { m << e } else { m >> (0 - e) }
}

// The integer part of `x`, saturated to [-2^127, 2^127).
export fn __fixdfti(x: f64) -> i128 {
    let lim = TWO_64 * TWO_64 / 2.0
    if x != x {
        return 0
    }
    let top: u128 = 1 << 127
    if x >= lim {
        return (top - 1) as i128
    }
    if x <= 0.0 - lim {
        return top as i128
    }
    if x < 0.0 {
        let u = __fixunsdfti(0.0 - x)
        (0 -% u) as i128
    } else {
        __fixunsdfti(x) as i128
    }
}

export fn __fixunssfti(x: f32) -> u128 {
    __fixunsdfti(x as f64)
}

export fn __fixsfti(x: f32) -> i128 {
    __fixdfti(x as f64)
}

#[test]
fn division() {
    let max = 0 -% (1 as u128)
    let top = (1 as u128) << 127
    let cases = [
        (max, 1 as u128),
        (max, max),
        (max, top + 1),
        (top, 3),
        ((1 as u128) << 100, (1 as u128) << 64),
        ((1234567890123456789 as u128) * 10000000000 + 123456789, 987654321987654321),
        (7, 1 << 70)
    ]
    for (n, d) in cases {
        let (q, r) = udivmod(n, d)
        assert(r < d && q *% d +% r == n, "n = q * d + r, r < d")
        assert(__udivti3(n, d) == q && __umodti3(n, d) == r, "exported")
    }
    assert(__udivti3(max, top + 1) == 1 && __umodti3(max, top + 1) == top - 2, "near the top")
    let min = top as i128
    assert(__divti3(-7, 2) == -3 && __modti3(-7, 2) == -1, "toward zero, as C")
    assert(__divti3(7, -2) == -3 && __modti3(7, -2) == 1, "the dividend's sign")
    assert(__divti3(min, -1) == min && __modti3(min, -1) == 0, "MIN / -1 wraps")
}

#[test]
fn conversions() {
    let max = 0 -% (1 as u128)
    assert(
        __floatuntidf(0) == 0.0 && __floatuntidf(1 << 100) == 1267650600228229401496703205376.0,
        "exact"
    )
    // 2^64 + 2^11 + 1 is above the halfway point between two f64s.
    let above = (1 as u128) << 64 | 2049
    assert(f64_bits(__floatuntidf(above)) == f64_bits(18446744073709555712.0), "the sticky bit")
    assert(__floatuntidf((1 as u128) << 64 | 2048) == 18446744073709551616.0, "ties to even")
    assert(__floattidf(-5) == -5.0 && __floatuntisf(max) == 1.0 as f32 / 0.0 as f32, "f32 overflow")
    assert(
        __fixunsdfti(0.0 / 0.0) == 0 && __fixunsdfti(-3.0) == 0 && __fixunsdfti(1e300) == max,
        "saturated"
    )
    assert(
        __fixunsdfti(2.75) == 2 && __fixunsdfti(1267650600228229401496703205376.0) == 1 << 100,
        "truncated"
    )
    let top = (1 as u128) << 127
    assert(__fixdfti(-1e300) == top as i128 && __fixdfti(1e300) == (top - 1) as i128, "signed ends")
    assert(
        __fixdfti(-2.5) == -2 && __fixdfti(-0.5) == 0 && __fixsfti(-3.5 as f32) == -3,
        "toward zero"
    )
}

// `x` without its fraction: the bits below the binary point cleared.
fn trunc_bits(x: f64) -> f64 {
    let b = f64_bits(x)
    let e = ((b >> 52) & 0x7ff) as i64 - 1023
    // Already whole, or infinite, or NaN.
    if e >= 52 { return x }
    // Less than 1: a zero of its sign.
    if e < 0 { return f64_of_bits(b & (1 << 63)) }
    let fraction = ((1 as u64) << (52 - e)) - 1
    f64_of_bits(b & (fraction ^ 0xffffffffffffffff))
}

fn floor_bits(x: f64) -> f64 {
    let t = trunc_bits(x)
    if x < 0.0 && t != x { t - 1.0 } else { t }
}

fn ceil_bits(x: f64) -> f64 {
    let t = trunc_bits(x)
    if x > 0.0 && t != x { t + 1.0 } else { t }
}

// To the nearest whole number, halves away from zero, as C's `round`.
fn round_bits(x: f64) -> f64 {
    let t = trunc_bits(x)
    // Exact: what `t` leaves of `x`.
    let rest = x - t
    if rest >= 0.5 { return t + 1.0 }
    if rest <= -0.5 { return t - 1.0 }
    t
}

// The remainder of `x / y` with the sign of `x`, exactly, as C's `fmod`:
// the mantissas' long division (musl's way).
fn fmod_bits(x: f64, y: f64) -> f64 {
    var ux = f64_bits(x)
    var uy = f64_bits(y)
    var ex = ((ux >> 52) & 0x7ff) as i64
    var ey = ((uy >> 52) & 0x7ff) as i64
    let sign = ux & (1 << 63)
    if uy << 1 == 0 || y != y || ex == 0x7ff {
        return f64_of_bits(0x7ff8000000000000)
    }
    if ux << 1 <= uy << 1 {
        if ux << 1 == uy << 1 { return f64_of_bits(sign) }
        return x
    }
    // Normalize: an explicit leading bit, subnormals shifted up to it.
    if ex == 0 {
        var i = ux << 12
        while i >> 63 == 0 {
            ex -= 1
            i = i << 1
        }
        ux = ux << (1 - ex)
    } else {
        ux = (ux & 0xfffffffffffff) | (1 << 52)
    }
    if ey == 0 {
        var i = uy << 12
        while i >> 63 == 0 {
            ey -= 1
            i = i << 1
        }
        uy = uy << (1 - ey)
    } else {
        uy = (uy & 0xfffffffffffff) | (1 << 52)
    }
    while ex > ey {
        let i = ux -% uy
        if i >> 63 == 0 {
            if i == 0 { return f64_of_bits(sign) }
            ux = i
        }
        ux = ux << 1
        ex -= 1
    }
    let i = ux -% uy
    if i >> 63 == 0 {
        if i == 0 { return f64_of_bits(sign) }
        ux = i
    }
    while ux >> 52 == 0 {
        ux = ux << 1
        ex -= 1
    }
    if ex > 0 {
        ux = (ux -% (1 << 52)) | ((ex as u64) << 52)
    } else {
        ux = ux >> (1 - ex)
    }
    f64_of_bits(ux | sign)
}

export fn fmod(x: f64, y: f64) -> f64 { fmod_bits(x, y) }

// In `f64`, where an `f32`'s remainder and whole parts are exact.
export fn fmodf(x: f32, y: f32) -> f32 { fmod_bits(x as f64, y as f64) as f32 }

export fn floor(x: f64) -> f64 { floor_bits(x) }

export fn floorf(x: f32) -> f32 { floor_bits(x as f64) as f32 }

export fn ceil(x: f64) -> f64 { ceil_bits(x) }

export fn ceilf(x: f32) -> f32 { ceil_bits(x as f64) as f32 }

export fn trunc(x: f64) -> f64 { trunc_bits(x) }

export fn truncf(x: f32) -> f32 { trunc_bits(x as f64) as f32 }

export fn round(x: f64) -> f64 { round_bits(x) }

export fn roundf(x: f32) -> f32 { round_bits(x as f64) as f32 }

#[test]
fn float_math() {
    // Compared by bits, so that a zero's sign counts.
    let cases = [
        (trunc_bits(2.7), 2.0),
        (trunc_bits(-2.7), -2.0),
        (trunc_bits(-0.5), -0.0),
        (trunc_bits(2251799813685248.5), 2251799813685248.0),
        (trunc_bits(1e300), 1e300),
        (floor_bits(-0.5), -1.0),
        (floor_bits(-0.0), -0.0),
        (floor_bits(2.0), 2.0),
        (floor_bits(-2.000001), -3.0),
        (ceil_bits(-0.5), -0.0),
        (ceil_bits(0.2), 1.0),
        (ceil_bits(-1.5), -1.0),
        (round_bits(2.5), 3.0),
        (round_bits(-2.5), -3.0),
        (round_bits(-0.4), -0.0),
        (round_bits(0.49999999999999994), 0.0),
        (round_bits(4503599627370495.5), 4503599627370496.0),
        (fmod_bits(7.5, 2.0), 1.5),
        (fmod_bits(-7.5, 2.0), -1.5),
        (fmod_bits(7.5, -2.0), 1.5),
        (fmod_bits(-4.0, 2.0), -0.0),
        (fmod_bits(1.0, 1e300), 1.0),
        (fmod_bits(1e300, 3.0), 0.0),
        (fmod_bits(5e-324 * 7.0, 5e-324 * 2.0), 5e-324),
        (fmod_bits(0.1, 1e-310), 3.135287412051e-311)
    ]
    for i, (got, want) in cases {
        assert(f64_bits(got) == f64_bits(want), "case " + i.to_string())
    }
    let nan = fmod_bits(1.0, 0.0)
    assert(nan != nan && fmod_bits(1.0 / 0.0, 2.0) != fmod_bits(1.0 / 0.0, 2.0), "NaN")
    let inf = 1.0 / 0.0
    assert(
        f64_bits(floor_bits(inf)) == f64_bits(inf) && round_bits(nan) != round_bits(nan),
        "special"
    )
    assert(floorf(-0.5 as f32) == -1.0 as f32 && fmodf(7.5 as f32, 2.0 as f32) == 1.5 as f32, "f32")
}
