// String: text, owned (UTF-8 bytes). A literal where a `String` is expected
// borrows the literal's bytes; the first change copies them.

import std.float
import std.mem
import std.vec

pub struct String {
    bytes: Vec(u8)
}

impl String {
    pub fn new() -> String
        ensures result.len() == 0
    {
        String { bytes: Vec(u8).new() }
    }

    pub fn with_capacity(n: i64) -> String
        ensures result.len() == 0
    {
        String { bytes: Vec(u8).with_capacity(n) }
    }

    // A `String` over bytes it does not own: a literal, or a `str` lent to
    // a function that borrows a `String`. The first change copies them.
    pub fn from_static(s: str) -> String {
        String { bytes: Vec(u8) { ptr: s.ptr, len: s.len, cap: 0 } }
    }

    pub fn from(s: str) -> String {
        var r = String.with_capacity(s.len)
        r.push_str(s)
        r
    }

    pub fn len(self) -> i64
        ensures result == self.bytes.len
    {
        self.bytes.len
    }

    pub fn is_empty(self) -> bool {
        self.bytes.len == 0
    }

    pub fn as_str(self) -> str
        ensures result.len == self.len()
    {
        unsafe { make_str(self.bytes.ptr, self.bytes.len) }
    }

    pub fn as_bytes(self) -> [u8]
        ensures result.len == self.len()
    {
        self.bytes.as_slice()
    }

    pub fn push(inout self, b: u8)
        ensures self.len() == old(self.len()) + 1
    {
        self.bytes.push(b)
    }

    pub fn push_str(inout self, s: str)
        ensures self.len() == old(self.len()) + s.len
    {
        self.bytes.reserve(s.len)
        unsafe {
            mem_copy(self.bytes.ptr + self.bytes.len, s.ptr, s.len)
        }
        self.bytes.len += s.len
    }

    pub fn clear(inout self) {
        self.bytes.clear()
    }

    pub fn add_assign(inout self, s: str) {
        self.push_str(s)
    }

    pub fn add(sink self, s: str) -> String {
        var r = self
        r.push_str(s)
        r
    }

    pub fn eq(self, other: str) -> bool {
        self.as_str().eq(other)
    }

    // `str`'s methods, on the text.
    pub fn trim(self) -> str { self.as_str().trim() }
    pub fn trim_start(self) -> str { self.as_str().trim_start() }
    pub fn trim_end(self) -> str { self.as_str().trim_end() }
    pub fn starts_with(self, p: str) -> bool { self.as_str().starts_with(p) }
    pub fn ends_with(self, p: str) -> bool { self.as_str().ends_with(p) }
    pub fn find(self, p: str) -> Option(i64) { self.as_str().find(p) }
    pub fn rfind(self, p: str) -> Option(i64) { self.as_str().rfind(p) }
    pub fn contains(self, p: str) -> bool { self.as_str().contains(p) }
    pub fn strip_prefix(self, p: str) -> Option(str) { self.as_str().strip_prefix(p) }
    pub fn strip_suffix(self, p: str) -> Option(str) { self.as_str().strip_suffix(p) }
    pub fn split(self, sep: str) -> Vec(str) { self.as_str().split(sep) }
    pub fn split_whitespace(self) -> Vec(str) { self.as_str().split_whitespace() }
    pub fn lines(self) -> Vec(str) { self.as_str().lines() }
    pub fn parse_int(self) -> Option(i64) { self.as_str().parse_int() }
    pub fn replace(self, from: str, to: str) -> String { self.as_str().replace(from, to) }
    pub fn to_upper(self) -> String { self.as_str().to_upper() }
    pub fn to_lower(self) -> String { self.as_str().to_lower() }
    pub fn repeat(self, n: i64) -> String { self.as_str().repeat(n) }

    pub fn into_bytes(sink self) -> Vec(u8) {
        var s = self
        s.bytes.reserve(0)
        if s.bytes.cap == 0 && s.bytes.len > 0 {
            s.bytes.reserve(1)
        }
        mem.replace(&s.bytes, Vec(u8).new())
    }
}

impl Clone for String {
    fn clone(self) -> String {
        String.from(self.as_str())
    }
}

impl Eq for String {
    fn eq(self, other: String) -> bool {
        self.as_str().eq(other.as_str())
    }
}

impl Ord for String {
    fn compare(self, other: String) -> Ordering {
        self.as_str().compare(other.as_str())
    }
}

impl Hash for String {
    fn hash(self) -> u64 {
        self.as_str().hash()
    }
}

impl Show for String {
    fn show(self, inout out: String) {
        out.push_str(self.as_str())
    }
}

impl Show for str {
    fn show(self, inout out: String) {
        out.push_str(self)
    }
}

impl Show for bool {
    fn show(self, inout out: String) {
        out.push_str(if self { "true" } else { "false" })
    }
}

// The shortest text that reads back as the same float (`std.float`).
impl Show for f64 {
    fn show(self, inout out: String) {
        float.write_shortest(&out, float.parts_f64(self))
    }
}

impl Show for f32 {
    fn show(self, inout out: String) {
        float.write_shortest(&out, float.parts_f32(self))
    }
}

impl(T: Int) Show for T {
    fn show(self, inout out: String) {
        if size_of(T) == 16 {
            show_128(self < (0 as T), self as u128, &out)
            return
        }
        var buf = [0 as u8; 24]
        var i = 24
        let neg = self < (0 as T)
        // Work in u64 so that the most negative value is fine.
        var n: u64 = if neg { 0 -% (self as i64) as u64 } else { self as u64 }
        if n == 0 {
            i -= 1
            buf[i] = '0'
        }
        while n > 0 {
            i -= 1
            buf[i] = '0' + (n % 10) as u8
            n = n / 10
        }
        if neg {
            i -= 1
            buf[i] = '-'
        }
        out.push_str(unsafe { make_str(&buf[i], 24 - i) })
    }
}

// A 128-bit integer given as its bits and whether it is negative: in
// pieces of 19 digits, so that only two divisions are 128-bit.
fn show_128(neg: bool, bits: u128, inout out: String) {
    var n = if neg { 0 -% bits } else { bits }
    let piece: u128 = 10000000000000000000
    var parts = [0 as u64; 3]
    var k = 0
    while n >= piece {
        parts[k] = (n % piece) as u64
        n = n / piece
        k += 1
    }
    if neg {
        out.push('-')
    }
    (n as u64).show(&out)
    while k > 0 {
        k -= 1
        let s = parts[k].to_string()
        for _ in 0..19 - s.len() {
            out.push('0')
        }
        out.push_str(s.as_str())
    }
}

impl str {
    // The bytes, as a slice.
    pub fn as_bytes(self) -> [u8]
        ensures result.len == self.len
    {
        unsafe { make_slice(self.ptr, self.len) }
    }

    pub fn to_string(self) -> String {
        String.from(self)
    }

    pub fn starts_with(self, p: str) -> bool {
        self.len >= p.len && self[0..p.len] == p
    }

    pub fn ends_with(self, p: str) -> bool {
        self.len >= p.len && self[self.len - p.len..] == p
    }

    // Where p first occurs.
    pub fn find(self, p: str) -> Option(i64) {
        if p.len > self.len {
            return None
        }
        var i = 0
        while i + p.len <= self.len {
            if self[i..i + p.len] == p {
                return Some(i)
            }
            i += 1
        }
        None
    }

    pub fn contains(self, p: str) -> bool {
        self.find(p).is_some()
    }

    // Without spaces, tabs and newlines at either end.
    pub fn trim(self) -> str {
        var a = 0
        var b = self.len
        while a < b && is_space(self[a]) {
            a += 1
        }
        while b > a && is_space(self[b - 1]) {
            b -= 1
        }
        self[a..b]
    }

    // The parts between occurrences of a separator.
    pub fn split(self, sep: str) -> Vec(str) {
        var out = Vec(str).new()
        var start = 0
        var i = 0
        while i + sep.len <= self.len {
            if sep.len > 0 && self[i..i + sep.len] == sep {
                out.push(self[start..i])
                i += sep.len
                start = i
            } else {
                i += 1
            }
        }
        out.push(self[start..])
        out
    }

    // The lines, without their newlines.
    pub fn lines(self) -> Vec(str) {
        var out = self.split("\n")
        if out.len() > 0 && out[out.len() - 1].len == 0 {
            out.pop()
        }
        out
    }

    // A decimal integer, with an optional sign; None if it does not fit
    // an `i64`.
    pub fn parse_int(self) -> Option(i64) {
        if self.len == 0 {
            return None
        }
        var i = 0
        var neg = false
        if self[0] == '-' || self[0] == '+' {
            neg = self[0] == '-'
            i = 1
        }
        if i == self.len {
            return None
        }
        // Counted down from 0, as -2^63 has no positive twin.
        let least = 0 - 9223372036854775807 - 1
        var n: i64 = 0
        while i < self.len {
            let c = self[i]
            if c < '0' || c > '9' {
                return None
            }
            let d = (c - '0') as i64
            if n < (least + d) / 10 {
                return None
            }
            n = n * 10 - d
            i += 1
        }
        if neg { return Some(n) }
        if n == least { return None }
        Some(0 - n)
    }

    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    // Without spaces, tabs and newlines at the start, or at the end.
    pub fn trim_start(self) -> str {
        var a = 0
        while a < self.len && is_space(self[a]) {
            a += 1
        }
        self[a..]
    }

    pub fn trim_end(self) -> str {
        var b = self.len
        while b > 0 && is_space(self[b - 1]) {
            b -= 1
        }
        self[..b]
    }

    // Where p last occurs.
    pub fn rfind(self, p: str) -> Option(i64) {
        if p.len > self.len {
            return None
        }
        var i = self.len - p.len
        while i >= 0 {
            if self[i..i + p.len] == p {
                return Some(i)
            }
            i -= 1
        }
        None
    }

    // Without the prefix (or suffix), if it starts (ends) with it.
    pub fn strip_prefix(self, p: str) -> Option(str) {
        if self.starts_with(p) { Some(self[p.len..]) } else { None }
    }

    pub fn strip_suffix(self, p: str) -> Option(str) {
        if self.ends_with(p) { Some(self[..self.len - p.len]) } else { None }
    }

    // Every occurrence of `from`, left to right and not overlapping,
    // replaced by `to`. An empty `from` replaces nothing.
    pub fn replace(self, from: str, to: str) -> String {
        var out = String.with_capacity(self.len)
        var start = 0
        var i = 0
        while from.len > 0 && i + from.len <= self.len {
            if self[i..i + from.len] == from {
                out.push_str(self[start..i])
                out.push_str(to)
                i += from.len
                start = i
            } else {
                i += 1
            }
        }
        out.push_str(self[start..])
        out
    }

    // ASCII letters changed to upper (lower) case; other bytes kept.
    pub fn to_upper(self) -> String {
        var out = String.with_capacity(self.len)
        for c in self {
            out.push(if c >= 'a' && c <= 'z' { c - 32 } else { c })
        }
        out
    }

    pub fn to_lower(self) -> String {
        var out = String.with_capacity(self.len)
        for c in self {
            out.push(if c >= 'A' && c <= 'Z' { c + 32 } else { c })
        }
        out
    }

    // `n` copies, one after another (none when `n` is not positive).
    pub fn repeat(self, n: i64) -> String {
        var out = String.with_capacity(if n > 0 { self.len * n } else { 0 })
        for _ in 0..n {
            out.push_str(self)
        }
        out
    }

    // The words: the parts between runs of spaces, tabs and newlines.
    pub fn split_whitespace(self) -> Vec(str) {
        var out = Vec(str).new()
        var i = 0
        while i < self.len {
            while i < self.len && is_space(self[i]) {
                i += 1
            }
            let start = i
            while i < self.len && !is_space(self[i]) {
                i += 1
            }
            if i > start {
                out.push(self[start..i])
            }
        }
        out
    }

    pub fn add(self, other: str) -> String {
        var r = String.with_capacity(self.len + other.len)
        r.push_str(self)
        r.push_str(other)
        r
    }
}

impl [str] {
    // The parts, with `sep` between each two.
    pub fn join(self, sep: str) -> String {
        var out = String.new()
        for i, x in self {
            if i > 0 {
                out.push_str(sep)
            }
            out.push_str(x)
        }
        out
    }
}

impl [String] {
    pub fn join(self, sep: str) -> String {
        var out = String.new()
        for i, x in self {
            if i > 0 {
                out.push_str(sep)
            }
            out.push_str(x.as_str())
        }
        out
    }
}

pub fn is_space(b: u8) -> bool {
    b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

pub fn is_digit(b: u8) -> bool {
    b >= '0' && b <= '9'
}

pub fn is_alpha(b: u8) -> bool {
    (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'
}

impl Default for String {
    fn default() -> String {
        String.new()
    }
}

// ---- tests (`jihoo test lib/std/string.jh`) ----

#[test]
fn push_grows() {
    var s = String.new()
    for _ in 0..100 {
        s.push('a')
    }
    s.push_str("bc")
    assert(s.len() == 102 && s.bytes.cap >= 102, "100 bytes and two more")
    assert(s.as_str().ends_with("abc"), "ends with abc")
}

#[test]
fn finds_and_splits() {
    let s = "  a,bb,,c  "
    assert(s.find(",") == Some(3), "first comma")
    assert(s.find(";").is_none(), "no semicolon")
    let parts = s.trim().split(",")
    assert(parts.len() == 4 && parts[1] == "bb" && parts[2] == "", "four parts")
}

#[test]
fn parses_ints() {
    assert("42".parse_int() == Some(42), "42")
    assert("-7".parse_int() == Some(-7), "-7")
    assert("".parse_int().is_none(), "empty")
    assert("4x".parse_int().is_none(), "4x")
    assert("+5".parse_int() == Some(5) && "-".parse_int().is_none(), "signs")
    assert("9223372036854775807".parse_int() == Some(9223372036854775807), "max")
    assert("-9223372036854775808".parse_int() == Some(0 - 9223372036854775807 - 1), "min")
    assert("9223372036854775808".parse_int().is_none(), "max + 1")
    assert("-9223372036854775809".parse_int().is_none(), "min - 1")
    assert("99999999999999999999".parse_int().is_none(), "far too large")
    assert("0000000000000000000000042".parse_int() == Some(42), "leading zeros")
}

#[test]
fn trims_finds_and_strips() {
    let s = " \t a b \n"
    assert(s.trim_start() == "a b \n" && s.trim_end() == " \t a b", "trim one end")
    assert("abcabc".rfind("bc") == Some(4) && "abc".rfind("x").is_none(), "rfind")
    assert("abc".rfind("") == Some(3) && "".rfind("a").is_none(), "rfind edges")
    assert("key=value".strip_prefix("key=") == Some("value"), "strip_prefix")
    assert("a.jh".strip_suffix(".jh") == Some("a") && "a".strip_suffix("b").is_none(), "suffix")
    assert("".is_empty() && !"a".is_empty(), "is_empty")
}

#[test]
fn replaces_and_changes_case() {
    assert("a-b-c".replace("-", "+") == "a+b+c", "replace")
    assert("aaa".replace("aa", "b") == "ba", "no overlap")
    assert("abc".replace("", "x") == "abc" && "abc".replace("bc", "") == "a", "empty parts")
    assert("Hello, World 42".to_upper() == "HELLO, WORLD 42", "upper")
    assert("Hello, World 42".to_lower() == "hello, world 42", "lower")
    assert("ab".repeat(3) == "ababab" && "ab".repeat(0) == "" && "ab".repeat(-1) == "", "repeat")
}

#[test]
fn words_and_joins() {
    let w = "  one two\t three\n\n".split_whitespace()
    assert(w.len() == 3 && w[0] == "one" && w[2] == "three", "words")
    assert(" \n".split_whitespace().len() == 0, "no words")
    assert(w.as_slice().join(", ") == "one, two, three", "join str")
    var owned = Vec(String).new()
    owned.push(String.from("x"))
    owned.push(String.from("y"))
    assert(owned.as_slice().join("") == "xy" && ["a"].join("-") == "a", "join String")
    let empty = Vec(str).new()
    assert(empty.as_slice().join(",") == "", "join none")
}

#[test]
fn string_has_str_methods() {
    let s = String.from("  Key: Value  ")
    assert(s.trim() == "Key: Value" && s.contains("Val") && s.find(":") == Some(5), "trim find")
    assert(s.to_lower().trim().starts_with("key") && s.split(":").len() == 2, "case split")
    assert(String.from("12").parse_int() == Some(12), "parse")
}
