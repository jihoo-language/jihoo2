// Sorting, in place.

// Sorts by `<`: a merge sort for long runs, insertion sort for short ones.
// Stable.
pub fn sort(comptime T: Ord, inout xs: Vec(T)) {
    sort_by(&xs, fn(a: T, b: T) -> bool { a < b })
}

// Sorts by a function saying whether its first argument goes first.
pub fn sort_by(comptime T: type, inout xs: Vec(T), comptime less: fn(T, T) -> bool) {
    let n = xs.len()
    if n < 2 {
        return
    }
    unsafe {
        let a = xs.ptr
        let tmp = mem.alloc(T, n)
        merge_sort(T, a, tmp, n, less)
        mem.dealloc(T, tmp, n)
    }
}

unsafe fn merge_sort(comptime T: type, a: *T, tmp: *T, n: i64, comptime less: fn(T, T) -> bool) {
    if n <= 16 {
        // Insertion sort.
        var i = 1
        while i < n {
            let x = read(a + i)
            var j = i
            while j > 0 && less(x, *(a + j - 1)) {
                write(a + j, read(a + j - 1))
                j -= 1
            }
            write(a + j, x)
            i += 1
        }
        return
    }
    let h = n / 2
    merge_sort(T, a, tmp, h, less)
    merge_sort(T, a + h, tmp, n - h, less)
    // Merge into tmp, then move back.
    var i = 0
    var j = h
    var k = 0
    while i < h && j < n {
        if less(*(a + j), *(a + i)) {
            write(tmp + k, read(a + j))
            j += 1
        } else {
            write(tmp + k, read(a + i))
            i += 1
        }
        k += 1
    }
    while i < h {
        write(tmp + k, read(a + i))
        i += 1
        k += 1
    }
    while j < n {
        write(tmp + k, read(a + j))
        j += 1
        k += 1
    }
    mem_copy(a, tmp, n)
}

impl(T: Ord) Vec(T) {
    // Sorts by `<`, stably: `sort.sort(&self)`.
    pub fn sort(inout self) {
        sort(&self)
    }

    // In a sorted `Vec`: Ok with where `x` is, or Err with where it would
    // go to keep the order.
    pub fn binary_search(self, x: T) -> Result(i64, i64) {
        self.as_slice().binary_search(x)
    }
}

impl(T: Ord) [T] {
    pub fn binary_search(self, x: T) -> Result(i64, i64) {
        var lo = 0
        var hi = self.len
        while lo < hi
            invariant 0 <= lo && lo <= hi && hi <= self.len
        {
            let mid = lo + (hi - lo) / 2
            match self[mid].compare(x) {
                Less => lo = mid + 1
                Greater => hi = mid
                Equal => return Ok(mid)
            }
        }
        Err(lo)
    }
}

impl(T: type) Vec(T) {
    // Sorts by a function saying whether its first argument goes first.
    pub fn sort_by(inout self, comptime less: fn(T, T) -> bool) {
        sort_by(&self, less)
    }
}

import std.mem

#[test]
fn sorts_and_sorts_by() {
    var v = Vec(i64).new()
    var x: i64 = 12345
    for _ in 0..300 {
        x = (x *% 1103515245 +% 12345) % 1000
        v.push(x)
    }
    sort(&v)
    for i in 1..v.len() {
        assert(v[i - 1] <= v[i], "ascending")
    }
    var w = Vec(String).new()
    for s in ["pear", "fig", "banana", "kiwi"] {
        w.push(String.from(s))
    }
    sort_by(&w, fn(a, b) { a.len() < b.len() })
    assert(w[0] == "fig" && w[3] == "banana", "by length")
    var e = Vec(i64).new()
    sort(&e)
    assert(e.is_empty(), "empty")
}

#[test]
fn methods_sort_and_search() {
    var v = [5, 1, 4, 1, 3].to_vec()
    v.sort()
    assert(v == [1, 1, 3, 4, 5].to_vec(), "sort")
    assert(v.binary_search(4) == Ok(3) && v.binary_search(2) == Err(2), "search")
    assert(v.binary_search(0) == Err(0) && v.binary_search(9) == Err(5), "search ends")
    let found = v.binary_search(1)
    assert(found == Ok(0) || found == Ok(1), "one of equals")
    v.sort_by(fn(a, b) { a > b })
    assert(v[0] == 5 && v[4] == 1, "sort_by")
    assert(Vec(i64).new().binary_search(1) == Err(0), "empty")
}
