// Lazy iterator adapters. Import std.iter to make the extension trait
// available. Adapters own their input iterator and hold their callbacks:
// a closure that borrows (`fn(x) { ... }`), so the adapter is a view, or a
// `move fn` that owns its captures, so the adapter can be returned.

import std.vec

pub struct Range {
    current: i64
    end: i64
}

// A half-open range. A reversed range is empty.
pub fn range(start: i64, end: i64) -> Range {
    Range { current: start, end: end }
}

impl Iterator for Range {
    type Item = i64

    fn next(inout self) -> Option(i64) {
        if self.current >= self.end { return None }
        let value = self.current
        self.current += 1
        Some(value)
    }
}

impl(T: type) [T] {
    pub fn iter(self) -> vec.Iter(T) {
        unsafe { vec.Iter(T) { ptr: self.ptr, end: self.ptr + self.len } }
    }
}

pub struct MapIter(I: Iterator, U: type, F: type) {
    inner: I
    transform: F
}

impl(I: Iterator, U: type, F: type) Iterator for MapIter(I, U, F) {
    type Item = U

    fn next(inout self) -> Option(U) {
        match self.inner.next() {
            Some(x) => Some(self.transform(x))
            None => None
        }
    }
}

pub struct FilterIter(I: Iterator, F: type) {
    inner: I
    pred: F
}

impl(I: Iterator, F: type) Iterator for FilterIter(I, F) {
    type Item = I.Item

    fn next(inout self) -> Option(I.Item) {
        loop {
            match self.inner.next() {
                Some(x) => { if self.pred(x) { return Some(x) } }
                None => return None
            }
        }
    }
}

impl(I: Iterator, F: type) FilterIter(I, F) {
    // Fuse the consumer into the source traversal. Repeatedly calling the
    // filtering next() leaves a nested search loop that inhibits if-conversion
    // even after callback inlining. Rejected items still drop before pulling
    // the next source item, and combine runs only for accepted items.
    pub fn fold(sink self, comptime A: type, sink initial: A, combine: fn(A, I.Item) -> A) -> A {
        var acc = initial
        loop {
            match self.inner.next() {
                Some(x) => { if self.pred(x) { acc = combine(acc, x) } }
                None => break
            }
        }
        acc
    }
}

pub struct TakeIter(I: Iterator) {
    inner: I
    remaining: i64
}

impl(I: Iterator) Iterator for TakeIter(I) {
    type Item = I.Item

    fn next(inout self) -> Option(I.Item) {
        if self.remaining <= 0 { return None }
        self.remaining -= 1
        self.inner.next()
    }
}

pub struct ZipIter(I: Iterator, J: Iterator) {
    left: I
    right: J
    done: bool
}

impl(I: Iterator, J: Iterator) Iterator for ZipIter(I, J) {
    type Item = (I.Item, J.Item)

    fn next(inout self) -> Option((I.Item, J.Item)) {
        if self.done { return None }
        match self.left.next() {
            Some(a) => match self.right.next() {
                Some(b) => return Some((a, b))
                None => {}
            }
            None => {}
        }
        self.done = true
        None
    }
}

// Each item with its position, from 0.
pub struct EnumerateIter(I: Iterator) {
    inner: I
    index: i64
}

impl(I: Iterator) Iterator for EnumerateIter(I) {
    type Item = (i64, I.Item)

    fn next(inout self) -> Option((i64, I.Item)) {
        match self.inner.next() {
            Some(x) => {
                let i = self.index
                self.index += 1
                Some((i, x))
            }
            None => None
        }
    }
}

// The items after the first `n`.
pub struct SkipIter(I: Iterator) {
    inner: I
    skip: i64
}

impl(I: Iterator) Iterator for SkipIter(I) {
    type Item = I.Item

    fn next(inout self) -> Option(I.Item) {
        while self.skip > 0 {
            self.skip -= 1
            match self.inner.next() {
                Some(_) => {}
                None => {
                    self.skip = 0
                    return None
                }
            }
        }
        self.inner.next()
    }
}

// The first item, then every `step`th after it.
pub struct StepIter(I: Iterator) {
    inner: I
    step: i64
    first: bool
}

impl(I: Iterator) Iterator for StepIter(I) {
    type Item = I.Item

    fn next(inout self) -> Option(I.Item) {
        if self.first {
            self.first = false
            return self.inner.next()
        }
        for _ in 1..self.step {
            match self.inner.next() {
                Some(_) => {}
                None => return None
            }
        }
        self.inner.next()
    }
}

// The items of one iterator, then those of another with the same items.
pub struct ChainIter(I: Iterator, J: Iterator) {
    first: I
    second: J
    first_done: bool
}

impl(I: Iterator, J: Iterator) Iterator for ChainIter(I, J) {
    type Item = I.Item

    fn next(inout self) -> Option(I.Item) {
        if !self.first_done {
            match self.first.next() {
                Some(x) => return Some(x)
                None => self.first_done = true
            }
        }
        self.second.next()
    }
}

// The items while the predicate holds, ending at the first that fails it
// (which is dropped).
pub struct TakeWhileIter(I: Iterator, F: type) {
    inner: I
    pred: F
    done: bool
}

impl(I: Iterator, F: type) Iterator for TakeWhileIter(I, F) {
    type Item = I.Item

    fn next(inout self) -> Option(I.Item) {
        if self.done { return None }
        match self.inner.next() {
            Some(x) => {
                if self.pred(x) { return Some(x) }
                self.done = true
                None
            }
            None => {
                self.done = true
                None
            }
        }
    }
}

// The items from the first that fails the predicate on.
pub struct SkipWhileIter(I: Iterator, F: type) {
    inner: I
    pred: F
    skipping: bool
}

impl(I: Iterator, F: type) Iterator for SkipWhileIter(I, F) {
    type Item = I.Item

    fn next(inout self) -> Option(I.Item) {
        if self.skipping {
            self.skipping = false
            loop {
                match self.inner.next() {
                    Some(x) => { if !self.pred(x) { return Some(x) } }
                    None => return None
                }
            }
        }
        self.inner.next()
    }
}

pub trait IteratorExt: Iterator {
    // U is inferred from the callback's result, or may be written explicitly.
    fn map(
        sink self,
        comptime U: type,
        comptime F: impl fn(Self.Item) -> U,
        sink transform: F
    ) -> MapIter(Self, U, F) {
        MapIter(Self, U, F) { inner: self, transform: transform }
    }

    fn filter(
        sink self,
        comptime F: impl fn(Self.Item) -> bool,
        sink pred: F
    ) -> FilterIter(Self, F) {
        FilterIter(Self, F) { inner: self, pred: pred }
    }

    // Zero and negative counts produce an empty iterator.
    fn take(sink self, n: i64) -> TakeIter(Self) {
        TakeIter(Self) { inner: self, remaining: n }
    }

    fn zip(sink self, comptime J: Iterator, sink other: J) -> ZipIter(Self, J) {
        ZipIter(Self, J) { left: self, right: other, done: false }
    }

    fn enumerate(sink self) -> EnumerateIter(Self) {
        EnumerateIter(Self) { inner: self, index: 0 }
    }

    // Zero and negative counts skip nothing.
    fn skip(sink self, n: i64) -> SkipIter(Self) {
        SkipIter(Self) { inner: self, skip: n }
    }

    // Panics if `step` is not positive.
    fn step_by(sink self, step: i64) -> StepIter(Self) {
        if step <= 0 { panic("step_by needs a positive step") }
        StepIter(Self) { inner: self, step, first: true }
    }

    // `other` must give the same items as this one.
    fn chain(sink self, comptime J: Iterator, sink other: J) -> ChainIter(Self, J) {
        ChainIter(Self, J) { first: self, second: other, first_done: false }
    }

    fn take_while(
        sink self,
        comptime F: impl fn(Self.Item) -> bool,
        sink pred: F
    ) -> TakeWhileIter(Self, F) {
        TakeWhileIter(Self, F) { inner: self, pred, done: false }
    }

    fn skip_while(
        sink self,
        comptime F: impl fn(Self.Item) -> bool,
        sink pred: F
    ) -> SkipWhileIter(Self, F) {
        SkipWhileIter(Self, F) { inner: self, pred, skipping: true }
    }

    // The items in a `Vec`, in order.
    fn collect(sink self) -> Vec(Self.Item) {
        var out = Vec(Self.Item).new()
        for x in self { out.push(x) }
        out
    }

    // The total of number items; 0 for none.
    fn sum(sink self) -> Self.Item {
        var acc: Self.Item = 0
        for x in self { acc = acc + x }
        acc
    }

    // The product of number items; 1 for none.
    fn product(sink self) -> Self.Item {
        var acc: Self.Item = 1
        for x in self { acc = acc * x }
        acc
    }

    // The first item the predicate holds of; the others before it are
    // dropped.
    fn find(sink self, pred: fn(Self.Item) -> bool) -> Option(Self.Item) {
        for x in self { if pred(x) { return Some(x) } }
        None
    }

    // The position of the first item the predicate holds of.
    fn position(sink self, pred: fn(Self.Item) -> bool) -> Option(i64) {
        var i = 0
        for x in self {
            if pred(x) { return Some(i) }
            i += 1
        }
        None
    }

    fn last(sink self) -> Option(Self.Item) {
        var out: Option(Self.Item) = None
        for x in self { out = Some(x) }
        out
    }

    // The item at position `n` (from 0), if there are that many.
    fn nth(sink self, n: i64) -> Option(Self.Item) {
        var it = self
        var i = 0
        loop {
            let Some(x) = it.next() else { return None }
            if i == n { return Some(x) }
            i += 1
        }
    }

    // The greatest item (the last of equals) and the least (the first),
    // for items with `Ord`.
    fn max(sink self) -> Option(Self.Item) {
        var out: Option(Self.Item) = None
        for x in self {
            out = match out {
                Some(m) => if x.compare(m) == Ordering.Less { Some(m) } else { Some(x) }
                None => Some(x)
            }
        }
        out
    }

    fn min(sink self) -> Option(Self.Item) {
        var out: Option(Self.Item) = None
        for x in self {
            out = match out {
                Some(m) => if x.compare(m) == Ordering.Less { Some(x) } else { Some(m) }
                None => Some(x)
            }
        }
        out
    }

    fn fold(sink self, comptime A: type, sink initial: A, combine: fn(A, Self.Item) -> A) -> A {
        var acc = initial
        for x in self { acc = combine(acc, x) }
        acc
    }

    fn for_each(sink self, f: fn(Self.Item)) {
        for x in self { f(x) }
    }

    fn count(sink self) -> i64 {
        var n = 0
        for _ in self { n += 1 }
        n
    }

    fn any(sink self, pred: fn(Self.Item) -> bool) -> bool {
        for x in self { if pred(x) { return true } }
        false
    }

    fn all(sink self, pred: fn(Self.Item) -> bool) -> bool {
        for x in self { if !pred(x) { return false } }
        true
    }
}

impl(I: Iterator) IteratorExt for I {}

#[test]
fn ranges_and_slices() {
    var r = range(2, 5)
    assert(r.next() == Some(2) && r.next() == Some(3) && r.next() == Some(4), "2 3 4")
    assert(r.next().is_none() && r.next().is_none(), "then none")
    assert(range(5, 2).count() == 0 && range(3, 3).count() == 0, "empty")
    let xs = [3, 1, 4, 1, 5]
    var sum = 0
    for x in xs[..].iter() {
        sum += x
    }
    assert(sum == 14 && xs[1..4].iter().count() == 3, "slice iter")
}

#[test]
fn adapters() {
    let squares = range(0, 10).map(fn(x) { x * x }).fold(0, fn(a, x) { a + x })
    assert(squares == 285, "map fold")
    let evens = range(0, 10).filter(fn(x) { x % 2 == 0 }).count()
    assert(evens == 5, "filter count")
    let odd_sum = range(0, 10).filter(fn(x) { x % 2 == 1 }).fold(0, fn(a, x) { a + x })
    assert(odd_sum == 25, "filter fold")
    assert(range(0, 100).take(3).count() == 3 && range(0, 2).take(5).count() == 2, "take")
    assert(range(0, 5).take(0).count() == 0 && range(0, 5).take(-1).count() == 0, "take none")
    var pairs = 0
    for (a, b) in range(0, 3).zip(range(10, 100)) {
        assert(b == a + 10, "zip pairs")
        pairs += 1
    }
    assert(pairs == 3, "zip ends with the shorter left")
    var z = range(0, 1).zip(range(0, 1))
    assert(z.next().is_some() && z.next().is_none() && z.next().is_none(), "zip stays done")
    assert(range(0, 5).zip(range(0, 2)).count() == 2, "zip shorter right")
    assert(range(1, 5).any(fn(x) { x == 4 }) && !range(1, 5).any(fn(x) { x > 4 }), "any")
    assert(range(1, 5).all(fn(x) { x > 0 }) && !range(1, 5).all(fn(x) { x < 4 }), "all")
    assert(!range(0, 0).any(fn(x) { true }) && range(0, 0).all(fn(x) { false }), "empty any all")
    var seen = 0
    range(0, 4).for_each(fn(x) { seen += x })
    assert(seen == 6, "for_each")
}

#[test]
fn owned_items() {
    var v = Vec(String).new()
    for i in 0..6 {
        v.push(i.to_string())
    }
    let long = v.into_iter().map(fn(s) { s + "!" }).filter(fn(s) { s != "3!" }).count()
    assert(long == 5, "strings mapped, filtered and dropped")
    let joined = range(0, 4).map(fn(i) { i.to_string() }).fold(
        String.new(),
        fn(a, s) { a + s.as_str() }
    )
    assert(joined == "0123", "fold owned")
}

#[test]
fn more_adapters() {
    let evens = range(0, 10).filter(fn(x) { x % 2 == 0 }).collect()
    assert(evens.len() == 5 && evens[4] == 8, "collect")
    assert(range(1, 5).sum() == 10 && range(0, 0).sum() == 0, "sum")
    assert(range(1, 6).product() == 120 && range(0, 0).product() == 1, "product")
    let halves = [0.5, 1.5, 2.0]
    assert(halves[..].iter().map(fn(x) { x * 2.0 }).sum() == 8.0, "float sum")
    var at = 0
    for (i, x) in range(10, 13).enumerate() {
        assert(x == 10 + i && i == at, "enumerate")
        at += 1
    }
    assert(at == 3, "enumerate all")
    assert(range(0, 10).skip(7).collect() == [7, 8, 9].to_vec(), "skip")
    assert(
        range(0, 3).skip(5).count() == 0 && range(0, 3).skip(-1).count() == 3,
        "skip all or none"
    )
    assert(range(0, 10).step_by(3).collect() == [0, 3, 6, 9].to_vec(), "step_by")
    assert(range(0, 2).chain(range(5, 7)).collect() == [0, 1, 5, 6].to_vec(), "chain")
    let small = range(0, 10).take_while(fn(x) { x * x < 20 }).collect()
    assert(small == [0, 1, 2, 3, 4].to_vec(), "take_while")
    let big = range(0, 10).skip_while(fn(x) { x < 7 }).collect()
    assert(big == [7, 8, 9].to_vec(), "skip_while")
    assert(range(0, 10).skip_while(fn(x) { x % 2 == 0 }).count() == 9, "skip_while stops once")
    assert(range(1, 100).find(fn(x) { x * x > 50 }) == Some(8), "find")
    assert(range(1, 5).find(fn(x) { x > 9 }).is_none(), "find none")
    assert(range(5, 10).position(fn(x) { x == 8 }) == Some(3), "position")
    assert(range(0, 4).last() == Some(3) && range(0, 0).last().is_none(), "last")
    assert(range(0, 4).nth(2) == Some(2) && range(0, 4).nth(4).is_none(), "nth")
    let xs = [3, 9, 2, 9, 1]
    assert(xs[..].iter().map(fn(x) { x }).max() == Some(9), "max")
    assert(xs[..].iter().map(fn(x) { x }).min() == Some(1), "min")
    assert(range(0, 0).max().is_none(), "max of none")
}

#[test]
fn owned_items_found_and_collected() {
    var v = Vec(String).new()
    for i in 0..5 {
        v.push(i.to_string())
    }
    let found = v.clone().into_iter().find(fn(s) { s == "3" })
    assert(found == Some(String.from("3")), "find owned")
    let words = v.into_iter().skip(1).step_by(2).collect()
    assert(words.len() == 2 && words[0] == "1" && words[1] == "3", "skip step collect")
    let names = ["b", "c", "a"]
    let first = names[..].iter().map(fn(s) { s.to_string() }).min()
    assert(first == Some(String.from("a")), "min of strings")
}
