// Threads that borrow. Parallel calls join before returning; scoped jobs
// join before the body borrowing their scope releases its locals. Work
// may borrow what the caller owns, without copying it or counting
// references. The borrow rules that keep
// two closures of one call from changing the same variable keep threads
// from racing (see docs/language/threads.md). Native programs use POSIX
// threads, freestanding ones `clone` (`std.os_thread`).

import std.os_thread
import std.mem
import std.sync

// The compiler keeps the loans stored here until it calls `finish` before
// the body borrowing the scope drops its locals. The registry owns every
// job, independently of whether its result handle is used or forgotten.
#[view]
pub struct Scope {
    jobs: Vec(ScopedJob)
}

struct ScopedJob {
    data: *u8
    wait: fnptr(*u8)
    destroy: fnptr(*u8)
}

struct ScopedResult(T: type) {
    result: Option(T)
    thread: u64
    joined: bool
}

struct ScopedTask(E: type, T: type) {
    result: ScopedResult(T)
    env: E
    run: fnptr(*E) -> T
}

// A result borrowed from its scope. Joining consumes the handle; dropping
// or forgetting it leaves the scope responsible for the job and result.
#[view]
pub struct ScopedJoinHandle(T: type) {
    task: *ScopedResult(T)
}

impl(T: type) ScopedJoinHandle(T) {
    pub fn join(sink self) -> T {
        unsafe {
            wait_task(self.task)
            mem.replace(&self.task[0].result, None).unwrap()
        }
    }
}

impl(T: type) Drop for ScopedJoinHandle(T) {
    fn drop(inout self) {}
}

unsafe fn wait_task(comptime T: type, task: *ScopedResult(T)) {
    if !task[0].joined {
        os_thread.wait(task[0].thread)
        task[0].joined = true
    }
}

impl Scope {
    fn checkpoint(self) -> i64 { self.jobs.len() }

    pub fn spawn(inout self, comptime T: type, work: fn() -> T) -> ScopedJoinHandle(T) {
        compile_error("`Scope.spawn` needs a compiler with scoped thread support")
    }

    // The compiler supplies a fresh capture tuple and its lifted entry.
    unsafe fn spawn_env(
        inout self,
        comptime E: type,
        comptime T: type,
        sink env: E,
        run: fnptr(*E) -> T,
        frame: ref i64
    ) -> ScopedJoinHandle(T) {
        unsafe {
            let task = mem.alloc(ScopedTask(E, T), 1)
            write(task, ScopedTask(E, T) {
                result: ScopedResult(T) { result: None, thread: 0, joined: false }
                env: env
                run: run
            })
            let t = os_thread.start_raw(fn(arg: *u8) {
                unsafe {
                    let p = arg as *ScopedTask(E, T)
                    let f = p[0].run
                    let result = f(&p[0].env)
                    write(&p[0].result.result, Some(result))
                }
            }, task as *u8)
            task[0].result.thread = t
            self.jobs.push(ScopedJob {
                data: task as *u8
                wait: fn(arg: *u8) { unsafe { wait_task(&(arg as *ScopedTask(E, T))[0].result) } }
                destroy: fn(arg: *u8) {
                    unsafe {
                        let p = arg as *ScopedTask(E, T)
                        mem.drop_at(p)
                        mem.dealloc(p, 1)
                    }
                }
            })
            ScopedJoinHandle(T) { task: &task[0].result }
        }
    }

    // Compiler-inserted before the function body releases any locals.
    // Unsafe to call by hand: existing result handles would dangle.
    pub unsafe fn finish(inout self, from: i64) {
        for job in self.jobs.as_slice()[from..] {
            let wait = job.wait
            wait(job.data)
        }
        for job in self.jobs.as_slice()[from..] {
            let destroy = job.destroy
            destroy(job.data)
        }
        while self.jobs.len() > from {
            self.jobs.pop()
        }
    }
}

impl Drop for Scope {
    fn drop(inout self) {
        unsafe { self.finish(0) }
    }
}

// Starts a scope, runs its body, and joins every thread before returning.
// Captured borrows last until the body's end, even after an explicit join.
pub fn scope(comptime R: type, f: fn(inout Scope) -> R) -> R {
    var s = Scope { jobs: Vec(ScopedJob).new() }
    f(&s)
}

// The number of processors online, at least 1.
pub fn cpu_count() -> i64 {
    os_thread.cpu_count()
}

// Runs `a` on a new thread and `b` on this one, and returns both results
// when both are done. Either may borrow what the caller owns; they may not
// both use a variable that one of them changes.
pub fn join(comptime A: type, comptime B: type, a: fn() -> A, b: fn() -> B) -> (A, B) {
    var ra: Option(A) = None
    let job = fn() { ra = Some(a()) }
    let t = unsafe { os_thread.start(&job) }
    let rb = b()
    unsafe { os_thread.wait(t) }
    (ra.unwrap(), rb)
}

// Calls `f(i)` for each `i` in `lo..hi`, on as many threads as there are
// processors. `f` runs on several threads at once, so it may not change
// what it captures.
pub fn each(lo: i64, hi: i64, comptime f: fn(i64)) {
    inline if captures_mut(f) {
        compile_error("`thread.each` calls its closure on several threads at once, so the closure cannot change what it captures or capture a closure")
    }
    each_in(lo, hi, levels(hi - lo), f)
}

// `f` of each element of `xs`, computed on several threads, in order.
pub fn map(comptime T: type, comptime U: type, xs: [T], comptime f: fn(T) -> U) -> Vec(U) {
    inline if captures_mut(f) {
        compile_error("`thread.map` calls its closure on several threads at once, so the closure cannot change what it captures or capture a closure")
    }
    var out = Vec(U).with_capacity(xs.len)
    let p = out.ptr
    // Each index is written once, by one thread.
    each_in(0, xs.len, levels(xs.len), fn(i) { unsafe { write(p + i, f(xs[i])) } })
    out.len = xs.len
    out
}

// Calls `f` on each element of `xs`, which it may change, on several
// threads.
pub fn each_mut(comptime T: type, inout xs: Vec(T), comptime f: fn(inout T)) {
    inline if captures_mut(f) {
        compile_error("`thread.each_mut` calls its closure on several threads at once, so the closure cannot change what it captures or capture a closure")
    }
    let p = xs.ptr
    let n = xs.len
    // Each element is lent to one thread.
    each_in(0, n, levels(n), fn(i) { unsafe { f(&p[i]) } })
}

// Calls `f(i)` for each `i` in `lo..hi` on one thread per processor, each
// taking the next index whenever it is free, so that a few costly indices
// do not keep the others waiting. Put the costliest first. Taking an index
// costs an atomic addition, so `each` suits many cheap, similar calls
// better.
pub fn each_uneven(lo: i64, hi: i64, comptime f: fn(i64)) {
    inline if captures_mut(f) {
        compile_error("`thread.each_uneven` calls its closure on several threads at once, so the closure cannot change what it captures or capture a closure")
    }
    take_each(lo, hi, f)
}

// `f` of each element of `xs`, in order, computed as `each_uneven` does.
pub fn map_uneven(comptime T: type, comptime U: type, xs: [T], comptime f: fn(T) -> U) -> Vec(U) {
    inline if captures_mut(f) {
        compile_error("`thread.map_uneven` calls its closure on several threads at once, so the closure cannot change what it captures or capture a closure")
    }
    var out = Vec(U).with_capacity(xs.len)
    let p = out.ptr
    // Each index is written once, by one thread.
    take_each(0, xs.len, fn(i) { unsafe { write(p + i, f(xs[i])) } })
    out.len = xs.len
    out
}

// Calls `f` on each element of `xs`, which it may change, as `each_uneven`
// does.
pub fn each_mut_uneven(comptime T: type, inout xs: Vec(T), comptime f: fn(inout T)) {
    inline if captures_mut(f) {
        compile_error("`thread.each_mut_uneven` calls its closure on several threads at once, so the closure cannot change what it captures or capture a closure")
    }
    let p = xs.ptr
    // Each element is lent to one thread.
    take_each(0, xs.len, fn(i) { unsafe { f(&p[i]) } })
}

// Each index of `lo..hi` taken once, by whichever worker asks first.
fn take_each(lo: i64, hi: i64, comptime f: fn(i64)) {
    let next = sync.Atomic(i64).new(lo)
    workers(min(cpu_count(), hi - lo), fn() {
        var i = next.add(1)
        while i < hi {
            f(i)
            i = next.add(1)
        }
    })
}

// Runs `work` on `k` threads at once, this one among them.
fn workers(k: i64, comptime work: fn()) {
    if k <= 1 {
        work()
        return
    }
    let half = k / 2
    join(fn() { workers(half, work) }, fn() { workers(k - half, work) })
}

// `lo..hi` split in two `depth` times, the halves run by `join`.
fn each_in(lo: i64, hi: i64, depth: i64, comptime f: fn(i64)) {
    if depth == 0 || hi - lo < 2 {
        for i in lo..hi {
            f(i)
        }
        return
    }
    let mid = lo + (hi - lo) / 2
    join(fn() { each_in(lo, mid, depth - 1, f) }, fn() { each_in(mid, hi, depth - 1, f) })
}

// How many times to halve `n` items: until there is a part per processor.
fn levels(n: i64) -> i64 {
    let k = min(cpu_count(), n)
    var d = 0
    while (1 << d) < k {
        d += 1
    }
    d
}

#[test]
fn join_both() {
    var left = Vec(i64).new()
    let (a, b) = join(fn() {
        left.push(1)
        String.from("a")
    }, fn() { 2 })
    assert(a == "a" && b == 2 && left.len() == 1, "both results")
    assert(cpu_count() >= 1, "a processor")
}

#[test]
fn each_and_map() {
    for n in [0, 1, 2, 3, 17, 1000] {
        let hits = sync.Atomic(i64).new(0)
        let sum = sync.Atomic(i64).new(0)
        each(5, 5 + n, fn(i) {
            hits.add(1)
            sum.add(i)
        })
        assert(hits.load() == n && sum.load() == n * (n + 9) / 2, "each index once")
        let uneven = sync.Atomic(i64).new(0)
        each_uneven(5, 5 + n, fn(i) { uneven.add(i) })
        assert(uneven.load() == sum.load(), "each_uneven index once")
    }
    each(3, 1, fn(i) { panic("a reversed range is empty") })
    var xs = Vec(i64).new()
    for i in 0..500 {
        xs.push(i)
    }
    let squares = map(xs.as_slice(), fn(x) { x * x })
    let names = map_uneven(xs.as_slice(), fn(x) { x.to_string() })
    assert(squares.len() == 500 && squares[499] == 249001, "map in order")
    assert(names.len() == 500 && names[123] == "123", "map_uneven owned, in order")
    assert(map(xs.as_slice()[0..0], fn(x) { x.to_string() }).is_empty(), "map nothing")
    each_mut(&xs, fn(x) { x *= 2 })
    each_mut_uneven(&xs, fn(x) { x += 1 })
    assert(xs[0] == 1 && xs[499] == 999, "each_mut")
}

// `scope` is tested by tests/run/scoped_threads.jh: the compiler does not
// join scoped jobs for functions of this module, which implements them.
