// Map(K, V): a hash map, with open addressing and linear probing.

import std.mem

pub struct Map(K: type, V: type) {
    // Each slot: 0 empty, 1 full, 2 deleted.
    state: Vec(u8)
    keys: *K
    vals: *V
    cap: i64
    len: i64
    used: i64
}

impl(K: Hash + Eq, V: type) Map(K, V) {
    pub fn new() -> Map(K, V) {
        Map(K, V) { state: Vec(u8).new(), keys: null, vals: null, cap: 0, len: 0, used: 0 }
    }

    pub fn len(self) -> i64 {
        self.len
    }

    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    // The slot of the key, or -1.
    fn find(self, k: K) -> i64 {
        if self.cap == 0 {
            return -1
        }
        let mask = self.cap - 1
        var i = (k.hash() as i64) & mask
        loop {
            let s = self.state[i]
            if s == 0 {
                return -1
            }
            if s == 1 && unsafe { (*(self.keys + i)).eq(k) } {
                return i
            }
            i = (i + 1) & mask
        }
    }

    pub fn contains(self, k: K) -> bool {
        self.find(k) >= 0
    }

    pub fn get(self, k: K) -> Option(ref V) {
        let i = self.find(k)
        if i < 0 {
            return None
        }
        unsafe { Some(*(self.vals + i)) }
    }

    pub fn get_mut(inout self, k: K) -> Option(inout V) {
        let i = self.find(k)
        if i < 0 {
            return None
        }
        unsafe { Some(*(self.vals + i)) }
    }

    pub fn index(self, k: K) -> ref V {
        let i = self.find(k)
        if i < 0 {
            panic("key not in the map")
        }
        unsafe { *(self.vals + i) }
    }

    pub fn index_mut(inout self, k: K) -> inout V {
        let i = self.find(k)
        if i < 0 {
            panic("key not in the map")
        }
        unsafe { *(self.vals + i) }
    }

    // Puts the value under the key; returns the one it replaces.
    pub fn insert(inout self, sink k: K, sink v: V) -> Option(V) {
        if (self.used + 1) * 4 > self.cap * 3 {
            self.grow()
        }
        let mask = self.cap - 1
        var i = (k.hash() as i64) & mask
        var tomb = -1
        loop {
            let s = self.state[i]
            if s == 0 {
                break
            }
            if s == 2 && tomb < 0 {
                tomb = i
            }
            if s == 1 && unsafe { (*(self.keys + i)).eq(k) } {
                let old = unsafe { mem.replace(&*(self.vals + i), v) }
                return Some(old)
            }
            i = (i + 1) & mask
        }
        if tomb >= 0 {
            i = tomb
        } else {
            self.used += 1
        }
        self.state[i] = 1
        unsafe {
            write(self.keys + i, k)
            write(self.vals + i, v)
        }
        self.len += 1
        None
    }

    pub fn remove(inout self, k: K) -> Option(V) {
        let i = self.find(k)
        if i < 0 {
            return None
        }
        self.state[i] = 2
        self.len -= 1
        unsafe {
            mem.drop_at(K, self.keys + i)
            Some(read(self.vals + i))
        }
    }

    fn grow(inout self) {
        let old_cap = self.cap
        let old_state = mem.replace(
            &self.state,
            Vec.filled(if old_cap == 0 { 8 } else { old_cap * 2 }, 0 as u8)
        )
        let old_keys = self.keys
        let old_vals = self.vals
        self.cap = self.state.len()
        unsafe {
            self.keys = mem.alloc(K, self.cap)
            self.vals = mem.alloc(V, self.cap)
        }
        self.len = 0
        self.used = 0
        let mask = self.cap - 1
        for i in 0..old_cap {
            if old_state[i] == 1 {
                unsafe {
                    let k = read(old_keys + i)
                    var j = (k.hash() as i64) & mask
                    while self.state[j] != 0 {
                        j = (j + 1) & mask
                    }
                    self.state[j] = 1
                    write(self.keys + j, k)
                    write(self.vals + j, read(old_vals + i))
                }
                self.len += 1
                self.used += 1
            }
        }
        unsafe {
            mem.dealloc(K, old_keys, old_cap)
            mem.dealloc(V, old_vals, old_cap)
        }
    }

    // The keys, in no particular order.
    pub fn keys(self) -> Vec(ref K) {
        var out = Vec(ref K).with_capacity(self.len)
        for i in 0..self.cap {
            if self.state[i] == 1 {
                unsafe { out.push(*(self.keys + i)) }
            }
        }
        out
    }

    // The values, in the order of `keys`.
    pub fn values(self) -> Vec(ref V) {
        var out = Vec(ref V).with_capacity(self.len)
        for i in 0..self.cap {
            if self.state[i] == 1 {
                unsafe { out.push(*(self.vals + i)) }
            }
        }
        out
    }

    // Borrows the entries one by one, as `(key, value)`, in the order of
    // `keys`: `for e in m` and `for e in m.iter()`.
    pub fn iter(self) -> Iter(K, V) {
        Iter(K, V) { state: self.state.as_slice(), keys: self.keys, vals: self.vals, next: 0 }
    }

    // Removes every entry, keeping the allocation.
    pub fn clear(inout self) {
        for i in 0..self.cap {
            if self.state[i] == 1 {
                unsafe {
                    mem.drop_at(K, self.keys + i)
                    mem.drop_at(V, self.vals + i)
                }
            }
            self.state[i] = 0
        }
        self.len = 0
        self.used = 0
    }
}

// Borrows the entries of a `Map` one by one.
#[view]
pub struct Iter(K: type, V: type) {
    state: [u8]
    keys: *K
    vals: *V
    next: i64
}

impl(K: type, V: type) Iterator for Iter(K, V) {
    type Item = (ref K, ref V)

    fn next(inout self) -> Option((ref K, ref V)) {
        while self.next < self.state.len {
            let i = self.next
            self.next += 1
            if self.state[i] == 1 {
                return unsafe { Some((*(self.keys + i), *(self.vals + i))) }
            }
        }
        None
    }
}

impl(K: type, V: type) Drop for Map(K, V) {
    fn drop(inout self) {
        for i in 0..self.cap {
            if self.state[i] == 1 {
                unsafe {
                    mem.drop_at(K, self.keys + i)
                    mem.drop_at(V, self.vals + i)
                }
            }
        }
        unsafe {
            mem.dealloc(K, self.keys, self.cap)
            mem.dealloc(V, self.vals, self.cap)
        }
    }
}

impl(K: Hash + Eq, V: type) Default for Map(K, V) {
    fn default() -> Map(K, V) {
        Map(K, V).new()
    }
}

#[test]
fn insert_get_and_replace() {
    var m = Map(i64, i64).new()
    assert(m.is_empty() && m.get(1).is_none(), "empty")
    for i in 0..200 {
        assert(m.insert(i, i * 2).is_none(), "new key")
    }
    assert(m.len() == 200 && m[150] == 300 && m.contains(199) && !m.contains(200), "200 keys")
    assert(m.insert(7, 0) == Some(14) && m[7] == 0 && m.len() == 200, "replaced")
    match m.get_mut(8) {
        Some(x) => x += 1
        None => assert(false, "8 is there")
    }
    m[9] += 5
    assert(m[8] == 17 && m[9] == 23, "changed in place")
}

#[test]
fn remove_keeps_the_rest() {
    var m = Map(String, i64).new()
    for i in 0..50 {
        m.insert(i.to_string(), i)
    }
    for i in 0..50 {
        if i % 3 == 0 {
            assert(m.remove(i.to_string()) == Some(i), "removed")
        }
    }
    assert(m.len() == 33 && m.remove(String.from("0")).is_none(), "33 left")
    for i in 0..50 {
        assert(m.contains(i.to_string()) == (i % 3 != 0), "the others remain")
    }
    assert(m.keys().len() == 33, "keys")
}

#[test]
fn iterate_and_clear() {
    var m = Map(String, i64).new()
    for i in 0..40 {
        m.insert(i.to_string(), i)
    }
    m.remove(String.from("7"))
    var sum = 0
    var count = 0
    for (k, v) in m {
        assert(k.as_str() == v.to_string().as_str(), "the key's value")
        sum += v
        count += 1
    }
    assert(count == 39 && sum == 780 - 7, "every entry once")
    var values = 0
    for v in m.values() { values += v }
    assert(values == sum && m.values().len() == m.keys().len(), "values")
    m.clear()
    assert(m.is_empty() && m.get(String.from("1")).is_none(), "cleared")
    var again = 0
    for _ in m.iter() { again += 1 }
    assert(again == 0, "nothing left")
    m.insert(String.from("x"), 5)
    assert(m.len() == 1 && m["x"] == 5, "usable after clear")
}
