// Printing and reading.

import std.os
import std.sys
import std.utf8

pub trait BufRead {
    // Append one UTF-8 line, including '\n'. Zero means end of input.
    // On error, out is restored to its original length; invalid UTF-8 is
    // `InvalidData`.
    fn read_line(inout self, inout out: String) -> Result(i64, os.Error)
}

pub struct StrReader {
    text: str
    pos: i64
}

impl StrReader {
    pub fn new(text: str) -> StrReader {
        StrReader { text, pos: 0 }
    }
}

impl BufRead for StrReader {
    fn read_line(inout self, inout out: String) -> Result(i64, os.Error) {
        let start = self.pos
        while self.pos < self.text.len {
            let b = self.text[self.pos]
            self.pos += 1
            if b == '\n' { break }
        }
        let line = self.text[start..self.pos]
        if utf8.validate(line).is_err() { return Err(os.Error.InvalidData) }
        out.push_str(line)
        Ok(self.pos - start)
    }
}

// Owns a file (or borrows a standard stream) and a buffer reused between
// lines.
pub struct BufReader {
    file: os.File
    buffer: Vec(u8)
    size: i64
    pos: i64
    end: i64
}

impl BufReader {
    pub fn open(path: str) -> Result(BufReader, os.Error) {
        Self.with_capacity(path, 65536)
    }

    pub fn with_capacity(path: str, capacity: i64) -> Result(BufReader, os.Error) {
        if capacity <= 0 { return Err(os.Error.InvalidInput) }
        let file = os.File.open(path)?
        Ok(BufReader {
            file,
            buffer: Vec(u8).with_capacity(capacity),
            size: capacity,
            pos: 0,
            end: 0
        })
    }

    // Reads lines from an open file, such as `os.stdin()`.
    pub fn new(sink file: os.File) -> BufReader {
        BufReader { file, buffer: Vec(u8).with_capacity(65536), size: 65536, pos: 0, end: 0 }
    }

    fn append_line(inout self, inout out: String) -> Result((), os.Error) {
        loop {
            if self.pos == self.end {
                self.buffer.clear()
                match self.file.read(&self.buffer, self.size) {
                    Ok(n) => {
                        self.pos = 0
                        self.end = n
                        if n == 0 { return Ok(()) }
                    }
                    Err(Interrupted) => continue
                    Err(e) => return Err(e)
                }
            }
            let start = self.pos
            while self.pos < self.end {
                let b = self.buffer[self.pos]
                self.pos += 1
                if b == '\n' { break }
            }
            let last = self.buffer[self.pos - 1]
            let part = unsafe { make_str(&self.buffer[start], self.pos - start) }
            out.push_str(part)
            if last == '\n' { return Ok(()) }
        }
    }
}

impl BufRead for BufReader {
    fn read_line(inout self, inout out: String) -> Result(i64, os.Error) {
        let start = out.len()
        var result = self.append_line(&out)
        if result.is_ok() && utf8.validate(out.as_str()[start..]).is_err() {
            result = Err(os.Error.InvalidData)
        }
        match result {
            Ok(_) => Ok(out.len() - start)
            Err(e) => {
                out.bytes.truncate(start)
                Err(e)
            }
        }
    }
}

// The lines of a reader one by one, without their `\n` (or `\r\n`), each
// a new `String`: `for line in io.stdin_lines() { let line = line? ... }`.
// It ends at the end of input, and after the first error, which it gives.
pub struct Lines(R: BufRead) {
    reader: R
    done: bool
}

impl(R: BufRead) Iterator for Lines(R) {
    type Item = Result(String, os.Error)

    fn next(inout self) -> Option(Result(String, os.Error)) {
        if self.done { return None }
        var line = String.new()
        match self.reader.read_line(&line) {
            Ok(0) => {
                self.done = true
                None
            }
            Ok(_) => {
                if line.len() > 0 && line.as_bytes()[line.len() - 1] == '\n' {
                    line.bytes.truncate(line.len() - 1)
                    if line.len() > 0 && line.as_bytes()[line.len() - 1] == '\r' {
                        line.bytes.truncate(line.len() - 1)
                    }
                }
                Some(Ok(line))
            }
            Err(e) => {
                self.done = true
                Some(Err(e))
            }
        }
    }
}

impl StrReader {
    pub fn lines(sink self) -> Lines(StrReader) {
        Lines(StrReader) { reader: self, done: false }
    }
}

impl BufReader {
    pub fn lines(sink self) -> Lines(BufReader) {
        Lines(BufReader) { reader: self, done: false }
    }
}

// The lines of standard input, buffered.
pub fn stdin_lines() -> Lines(BufReader) {
    BufReader.new(os.stdin()).lines()
}

pub fn print(comptime T: Show, x: T) {
    var s = String.new()
    x.show(&s)
    sys.write_fd(1, s.as_str())
}

pub fn println(comptime T: Show, x: T) {
    var s = String.new()
    x.show(&s)
    s.push('\n')
    sys.write_fd(1, s.as_str())
}

pub fn eprintln(comptime T: Show, x: T) {
    var s = String.new()
    x.show(&s)
    s.push('\n')
    sys.write_fd(2, s.as_str())
}

#[test]
fn str_reader_lines() {
    var r = StrReader.new("one\ntwo\n\nlast")
    var s = String.new()
    assert(r.read_line(&s) == Ok(4) && s == "one\n", "first line with its newline")
    assert(r.read_line(&s) == Ok(4) && s == "one\ntwo\n", "appended")
    s.clear()
    assert(r.read_line(&s) == Ok(1) && s == "\n", "empty line")
    s.clear()
    assert(r.read_line(&s) == Ok(4) && s == "last", "no final newline")
    assert(r.read_line(&s) == Ok(0) && r.read_line(&s) == Ok(0), "end")
}

#[test]
fn str_reader_invalid_utf8() {
    let bytes = [104 as u8, 0xff, 10, 111, 107, 10]
    var r = StrReader.new(unsafe { make_str(&bytes[0], 6) })
    var s = String.from("keep")
    assert(r.read_line(&s) == Err(os.Error.InvalidData) && s == "keep", "invalid line rejected")
    assert(r.read_line(&s) == Ok(3) && s == "keepok\n", "next line read")
}

// A reader of the pipe's read end with a buffer of `size` bytes, so that
// lines cross refills.
fn piped(text: [u8], size: i64) -> BufReader {
    let (rd, wr) = os.pipe().unwrap()
    var w = wr
    w.write_all(text).unwrap()
    BufReader { file: rd, buffer: Vec(u8).with_capacity(size), size, pos: 0, end: 0 }
}

#[test]
fn buf_reader_lines_across_refills() {
    var r = piped("abcdefghij\nxy\n\nhé llo\nend".as_bytes(), 3)
    var s = String.new()
    assert(r.read_line(&s) == Ok(11) && s == "abcdefghij\n", "longer than the buffer")
    s.clear()
    assert(r.read_line(&s) == Ok(3) && s == "xy\n", "ends at a refill")
    s.clear()
    assert(r.read_line(&s) == Ok(1) && s == "\n", "empty line")
    s.clear()
    assert(r.read_line(&s) == Ok(8) && s == "hé llo\n", "a character split by a refill")
    s.clear()
    assert(r.read_line(&s) == Ok(3) && s == "end", "no final newline")
    assert(r.read_line(&s) == Ok(0) && s == "end", "end")
}

#[test]
fn buf_reader_invalid_utf8() {
    let bytes = [97 as u8, 98, 0xc3, 10, 111, 107, 10]
    var r = piped(bytes[..], 2)
    var s = String.from(">")
    assert(r.read_line(&s) == Err(os.Error.InvalidData) && s == ">", "restored")
    assert(r.read_line(&s) == Ok(3) && s == ">ok\n", "next line")
    assert(BufReader.with_capacity("/", 0).is_err(), "zero capacity")
    var d = BufReader.open("/").unwrap()
    assert(d.read_line(&s) == Err(os.Error.IsADirectory) && s == ">ok\n", "read error")
}

#[test]
fn lines_without_newlines() {
    var got = Vec(String).new()
    for line in StrReader.new("one\ntwo\r\n\nlast").lines() {
        got.push(line.unwrap())
    }
    assert(got.len() == 4 && got[0] == "one" && got[1] == "two" && got[2] == "" && got[3] == "last",
        "four lines")
    var none = 0
    for _ in StrReader.new("").lines() { none += 1 }
    assert(none == 0, "no lines")
    var bad = StrReader.new("ok\n").lines()
    assert(bad.next() == Some(Ok(String.from("ok"))) && bad.next().is_none(), "then the end")
    var r = piped("a\nbb\n".as_bytes(), 1)
    var n = 0
    for line in r.lines() {
        n += line.unwrap().len()
    }
    assert(n == 3, "buffered lines")
    let bytes = [97 as u8, 10, 0xc3, 10, 98, 10]
    var e = piped(bytes[..], 4).lines()
    assert(e.next() == Some(Ok(String.from("a"))), "before the error")
    assert(e.next() == Some(Err(os.Error.InvalidData)) && e.next().is_none(), "the error ends it")
}
