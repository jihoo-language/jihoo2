// The prelude: what every module sees without importing it. The modules it
// imports with `pub import` are seen everywhere too.

pub import std.mem
pub import std.boxed
pub import std.vec
pub import std.string
pub import std.io
pub import std.map
pub import std.sort

pub enum Option(T: type) {
    Some(T)
    None
}

pub enum Result(T: type, E: type) {
    Ok(T)
    Err(E)
}

pub enum Ordering {
    Less
    Equal
    Greater
}

impl Eq for Ordering {
    fn eq(self, other: Ordering) -> bool {
        variant_of(self) == variant_of(other)
    }
}

// `Less`, `Equal`, `Greater`.
impl Show for Ordering {
    fn show(self, inout out: String) {
        out.push_str(match self {
            Less => "Less"
            Equal => "Equal"
            Greater => "Greater"
        })
    }
}

// ---- traits ----

// Runs when a value's owner goes away.
pub trait Drop {
    fn drop(inout self)
}

pub trait Clone {
    fn clone(self) -> Self
}

pub trait Eq {
    fn eq(self, other: Self) -> bool
}

pub trait Ord {
    fn compare(self, other: Self) -> Ordering
}

pub trait Hash {
    fn hash(self) -> u64
}

// Writes a value as text.
pub trait Show {
    fn show(self, inout out: String)

    fn to_string(self) -> String {
        var s = String.new()
        self.show(&s)
        s
    }
}

pub trait Default {
    fn default() -> Self
}

pub trait Iterator {
    type Item
    fn next(inout self) -> Option(Self.Item)
}

// Implemented by the compiler: values without owned memory (they copy),
// integers, floats.
pub trait Plain {}
pub trait Int {}
pub trait Signed {}
pub trait Unsigned {}
pub trait Float {}
pub trait Number {}

impl(T: Plain) Clone for T {
    fn clone(self) -> T {
        self
    }
}

impl(T: Number) Eq for T {
    fn eq(self, other: T) -> bool {
        self == other
    }
}

impl Eq for bool {
    fn eq(self, other: bool) -> bool {
        self == other
    }
}

// So that a `Result((), E)` compares.
impl Eq for () {
    fn eq(self, other: ()) -> bool {
        true
    }
}

impl(T: Number) Ord for T {
    fn compare(self, other: T) -> Ordering {
        if self < other {
            Ordering.Less
        } else if self > other {
            Ordering.Greater
        } else {
            Ordering.Equal
        }
    }
}

impl(T: Int) Hash for T {
    fn hash(self) -> u64 {
        if size_of(T) == 16 {
            // both halves
            let x = self as u128
            return mix64((x as u64) ^ mix64((x >> 64) as u64))
        }
        mix64(self as u64)
    }
}

// A 64-bit mix (from SplitMix64).
fn mix64(v: u64) -> u64 {
    var x = v
    x = (x ^ (x >> 30)) *% 0xbf58476d1ce4e5b9
    x = (x ^ (x >> 27)) *% 0x94d049bb133111eb
    x ^ (x >> 31)
}

impl(T: Number) Default for T {
    fn default() -> T {
        0 as T
    }
}

impl Default for bool {
    fn default() -> bool {
        false
    }
}

impl(T: type) Default for Option(T) {
    fn default() -> Option(T) {
        None
    }
}

impl Eq for str {
    fn eq(self, other: str) -> bool {
        if self.len != other.len {
            return false
        }
        var i = 0
        while i < self.len {
            if self[i] != other[i] {
                return false
            }
            i += 1
        }
        true
    }
}

impl Ord for str {
    fn compare(self, other: str) -> Ordering {
        let n = if self.len < other.len { self.len } else { other.len }
        var i = 0
        while i < n {
            if self[i] != other[i] {
                return if self[i] < other[i] { Ordering.Less } else { Ordering.Greater }
            }
            i += 1
        }
        self.len.compare(other.len)
    }
}

impl Hash for str {
    fn hash(self) -> u64 {
        // FNV-1a
        var h: u64 = 0xcbf29ce484222325
        for b in self {
            h = (h ^ (b as u64)) *% 0x100000001b3
        }
        h
    }
}

// ---- Option and Result ----

impl(T: type) Option(T) {
    pub fn is_some(self) -> bool {
        match self {
            Some(_) => true
            None => false
        }
    }

    pub fn is_none(self) -> bool {
        !self.is_some()
    }

    pub fn unwrap(sink self) -> T {
        match self {
            Some(x) => x
            None => panic("unwrap of None")
        }
    }

    pub fn expect(sink self, msg: str) -> T {
        match self {
            Some(x) => x
            None => panic(msg)
        }
    }

    pub fn unwrap_or(sink self, sink other: T) -> T {
        match self {
            Some(x) => x
            None => other
        }
    }

    pub fn unwrap_or_else(sink self, f: fn() -> T) -> T {
        match self {
            Some(x) => x
            None => f()
        }
    }

    // The value given to `f`; U is inferred from its result.
    pub fn map(sink self, comptime U: type, f: fn(T) -> U) -> Option(U) {
        match self {
            Some(x) => Some(f(x))
            None => None
        }
    }

    pub fn and_then(sink self, comptime U: type, f: fn(T) -> Option(U)) -> Option(U) {
        match self {
            Some(x) => f(x)
            None => None
        }
    }

    // The value if `pred` holds of it.
    pub fn filter(sink self, pred: fn(T) -> bool) -> Option(T) {
        match self {
            Some(x) => if pred(x) { Some(x) } else { None }
            None => None
        }
    }

    // This one if it has a value, or else `other`.
    pub fn or(sink self, sink other: Option(T)) -> Option(T) {
        match self {
            Some(x) => Some(x)
            None => other
        }
    }

    pub fn ok_or(sink self, comptime E: type, sink err: E) -> Result(T, E) {
        match self {
            Some(x) => Ok(x)
            None => Err(err)
        }
    }

    // A borrow of the value, leaving it in place.
    pub fn as_ref(self) -> Option(ref T) {
        match self {
            Some(x) => Some(x)
            None => None
        }
    }

    // Takes the value out, leaving None.
    pub fn take(inout self) -> Option(T) {
        mem.replace(&self, None)
    }

    // Puts a value in, giving back the one there was.
    pub fn replace(inout self, sink x: T) -> Option(T) {
        mem.replace(&self, Some(x))
    }
}

impl(T: type, E: type) Result(T, E) {
    pub fn is_ok(self) -> bool {
        match self {
            Ok(_) => true
            Err(_) => false
        }
    }

    pub fn is_err(self) -> bool {
        !self.is_ok()
    }

    pub fn unwrap(sink self) -> T {
        match self {
            Ok(x) => x
            Err(_) => panic("unwrap of Err")
        }
    }

    pub fn expect(sink self, msg: str) -> T {
        match self {
            Ok(x) => x
            Err(_) => panic(msg)
        }
    }

    pub fn ok(sink self) -> Option(T) {
        match self {
            Ok(x) => Some(x)
            Err(_) => None
        }
    }

    pub fn err(sink self) -> Option(E) {
        match self {
            Ok(_) => None
            Err(e) => Some(e)
        }
    }

    pub fn unwrap_err(sink self) -> E {
        match self {
            Ok(_) => panic("unwrap_err of Ok")
            Err(e) => e
        }
    }

    pub fn unwrap_or(sink self, sink other: T) -> T {
        match self {
            Ok(x) => x
            Err(_) => other
        }
    }

    pub fn unwrap_or_else(sink self, f: fn(E) -> T) -> T {
        match self {
            Ok(x) => x
            Err(e) => f(e)
        }
    }

    pub fn map(sink self, comptime U: type, f: fn(T) -> U) -> Result(U, E) {
        match self {
            Ok(x) => Ok(f(x))
            Err(e) => Err(e)
        }
    }

    pub fn map_err(sink self, comptime F: type, f: fn(E) -> F) -> Result(T, F) {
        match self {
            Ok(x) => Ok(x)
            Err(e) => Err(f(e))
        }
    }

    pub fn and_then(sink self, comptime U: type, f: fn(T) -> Result(U, E)) -> Result(U, E) {
        match self {
            Ok(x) => f(x)
            Err(e) => Err(e)
        }
    }
}

impl(T: Clone) Clone for Option(T) {
    fn clone(self) -> Option(T) {
        match self {
            Some(x) => Some(x.clone())
            None => None
        }
    }
}

impl(T: Clone, E: Clone) Clone for Result(T, E) {
    fn clone(self) -> Result(T, E) {
        match self {
            Ok(x) => Ok(x.clone())
            Err(e) => Err(e.clone())
        }
    }
}

impl(T: Eq) Eq for Option(T) {
    fn eq(self, other: Option(T)) -> bool {
        match self {
            Some(a) => match other {
                Some(b) => a.eq(b)
                None => false
            }
            None => other.is_none()
        }
    }
}

// `Some(5)`, `None`.
impl(T: Show) Show for Option(T) {
    fn show(self, inout out: String) {
        match self {
            Some(x) => {
                out.push_str("Some(")
                x.show(&out)
                out.push(')')
            }
            None => out.push_str("None")
        }
    }
}

// `Ok(5)`, `Err(not found)`.
impl(T: Show, E: Show) Show for Result(T, E) {
    fn show(self, inout out: String) {
        match self {
            Ok(x) => {
                out.push_str("Ok(")
                x.show(&out)
            }
            Err(e) => {
                out.push_str("Err(")
                e.show(&out)
            }
        }
        out.push(')')
    }
}

impl(T: Eq, E: Eq) Eq for Result(T, E) {
    fn eq(self, other: Result(T, E)) -> bool {
        match self {
            Ok(a) => match other {
                Ok(b) => a.eq(b)
                Err(_) => false
            }
            Err(a) => match other {
                Ok(_) => false
                Err(b) => a.eq(b)
            }
        }
    }
}

// ---- stopping ----

// Stops the program with a message.
pub fn panic(msg: str) -> never {
    sys.write_err("panic: ")
    sys.write_err(msg)
    sys.write_err("\n")
    sys.abort()
}

pub fn assert(cond: bool, msg: str) {
    if !cond {
        panic(msg)
    }
}

// Drops a value now.
pub fn drop(comptime T: type, sink x: T) {}

pub fn min(comptime T: Ord, a: T, b: T) -> T {
    if b < a { b.clone() } else { a.clone() }
}

pub fn max(comptime T: Ord, a: T, b: T) -> T {
    if b > a { b.clone() } else { a.clone() }
}

import std.sys

#[test]
fn option_combinators() {
    let five: Option(i64) = Some(5)
    let none: Option(i64) = None
    assert(five.map(fn(x) { x * 2 }) == Some(10) && none.map(fn(x) { x * 2 }).is_none(), "map")
    assert(five.map(fn(x) { x > 3 }) == Some(true), "map changes the type")
    assert(five.and_then(fn(x) { if x > 3 { Some(x - 3) } else { None } }) == Some(2), "and_then")
    assert(
        five.filter(fn(x) { x > 9 }).is_none() && five.filter(fn(x) { x > 1 }) == Some(5),
        "filter"
    )
    assert(none.or(Some(1)) == Some(1) && five.or(Some(1)) == Some(5), "or")
    assert(none.unwrap_or_else(fn() { 9 }) == 9 && five.unwrap_or_else(fn() { 9 }) == 5, "or_else")
    assert(five.ok_or("none") == Ok(5) && none.ok_or("none") == Err("none"), "ok_or")
    var slot = Some(String.from("a"))
    assert(slot.as_ref().is_some() && slot.is_some(), "as_ref leaves the value")
    assert(slot.replace(String.from("b")) == Some(String.from("a")), "replace")
    assert(slot.take() == Some(String.from("b")) && slot.is_none(), "take")
    assert(slot.take().is_none(), "take of None")
}

#[test]
fn result_combinators() {
    let ok: Result(i64, String) = Ok(4)
    let bad: Result(i64, String) = Err(String.from("no"))
    assert(ok.clone().map(fn(x) { x + 1 }) == Ok(5), "map")
    assert(bad.clone().map_err(fn(e) { e.len() }) == Err(2), "map_err")
    let halve = fn(x: i64) -> Result(i64, String) {
        if x % 2 == 0 { Ok(x / 2) } else { Err(String.from("odd")) }
    }
    assert(ok.clone().and_then(halve) == Ok(2), "and_then")
    let three: Result(i64, String) = Ok(3)
    assert(three.and_then(halve) == Err(String.from("odd")), "and_then fails")
    assert(bad.clone().unwrap_or(0) == 0 && ok.clone().unwrap_or(0) == 4, "unwrap_or")
    assert(bad.clone().unwrap_or_else(fn(e) { e.len() }) == 2, "unwrap_or_else")
    assert(bad.unwrap_err() == "no", "unwrap_err")
}
