// Memory: allocation, and moving values in and out of places.

import std.sys

// Room for n values of type T, not initialized. Never null.
pub unsafe fn alloc(comptime T: type, n: i64) -> *T {
    if size_of(T) == 0 || n == 0 {
        return align_of(T) as *T
    }
    sys.alloc_bytes(n * size_of(T)) as *T
}

pub unsafe fn realloc(comptime T: type, p: *T, old: i64, n: i64) -> *T {
    if size_of(T) == 0 {
        return p
    }
    if old == 0 {
        return alloc(T, n)
    }
    sys.realloc_bytes(p as *u8, n * size_of(T)) as *T
}

pub unsafe fn dealloc(comptime T: type, p: *T, n: i64) {
    if size_of(T) != 0 && n != 0 {
        sys.free_bytes(p as *u8)
    }
}

// Puts v in the place and returns what was there.
pub fn replace(comptime T: type, inout place: T, sink v: T) -> T {
    unsafe {
        let old = read(&place)
        write(&place, v)
        old
    }
}

pub fn swap(comptime T: type, inout a: T, inout b: T) {
    unsafe {
        let t = read(&a)
        write(&a, read(&b))
        write(&b, t)
    }
}

// Takes the value out of a place, leaving the type's default.
pub fn take(comptime T: Default, inout place: T) -> T {
    replace(&place, T.default())
}

// Runs the destructor of the value at p.
pub unsafe fn drop_at(comptime T: type, p: *T) {
    if needs_drop(T) {
        drop(read(p))
    }
}

// The heap value behind a `dyn Trait` or `dyn fn`: the compiler moves the
// value into one allocation and puts `dyn_drop` first in its table.
pub fn dyn_box(comptime T: type, sink v: T) -> *u8 {
    unsafe {
        let p = alloc(T, 1)
        write(p, v)
        p as *u8
    }
}

pub unsafe fn dyn_drop(comptime T: type, p: *u8) {
    drop_at(T, p as *T)
    dealloc(T, p as *T, 1)
}

#[test]
fn moving_values() {
    var a = String.from("a")
    var b = String.from("b")
    swap(&a, &b)
    assert(a == "b" && b == "a", "swap")
    let old = replace(&a, String.from("c"))
    assert(old == "b" && a == "c", "replace")
    let t = take(&a)
    assert(t == "c" && a.is_empty(), "take leaves the default")
    var n = 3
    assert(take(&n) == 3 && n == 0, "take an integer")
}

#[test]
fn allocation() {
    unsafe {
        let p = alloc(String, 2)
        write(p, String.from("x"))
        write(p + 1, String.from("y"))
        let q = realloc(String, p, 2, 100)
        assert(*(q + 1) == "y", "realloc keeps values")
        drop_at(q)
        drop_at(q + 1)
        dealloc(q, 100)
        // Nothing to allocate: a pointer that is not null, and aligned.
        let e = alloc(u64, 0)
        assert(e != null && (e as i64) % 8 == 0, "zero elements")
        dealloc(e, 0)
        let z = alloc((), 10)
        assert(z != null, "zero-sized")
        dealloc(z, 10)
        let r = realloc(i64, null, 0, 4)
        *(r + 3) = 7
        assert(*(r + 3) == 7, "realloc from nothing")
        dealloc(r, 4)
        let d = dyn_box(String.from("boxed"))
        dyn_drop(String, d)
    }
}
