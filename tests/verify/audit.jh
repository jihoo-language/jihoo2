// `--audit-proved` keeps the checks verification proves, and gives each
// the message of a verifier bug: a program built this way, and its tests,
// test the verifier. The runner's verify suite builds this file with and
// without it and compares the IR's messages.

fn next(xs: [i64; 4], i: i64) -> i64
    requires 0 <= i && i < 3
{
    xs[i + 1]
}

fn main() {
    println(next([1, 2, 3, 4], 2))
}

//> 9:8: proved integer overflow in next
//> 9:5: proved index out of bounds in next
