// `decreases d` on a function: every call to itself passes arguments for
// which `d` is smaller, and `d` is not negative on entry, so the recursion
// ends. So does every call to another function in a cycle of direct
// calls with it that states `decreases` too, compared over the parts both
// measures have. A tuple is compared in order: Ackermann's function ends
// because each call makes `m` smaller, or keeps it and makes `n` smaller.

fn fact(n: i64) -> i64
    requires n >= 0
    decreases n
{
    if n == 0 { 1 } else { n *% fact(n - 1) }
}

fn gcd(a: i64, b: i64) -> i64
    requires a >= 0 && b >= 0
    decreases b
{
    if b == 0 { a } else { gcd(b, a % b) }
}

fn bsearch(xs: [i64], key: i64, lo: i64, hi: i64) -> i64
    requires 0 <= lo <= hi <= xs.len
    decreases hi - lo
{
    if lo >= hi { return lo }
    let mid = lo + (hi - lo) / 2
    if xs[mid] < key { bsearch(xs, key, mid + 1, hi) } else { bsearch(xs, key, lo, mid) }
}

fn ack(m: i64, n: i64) -> i64
    requires m >= 0 && n >= 0
    ensures result >= 0
    decreases (m, n)
{
    if m == 0 { return n + 1 }
    if n == 0 { return ack(m - 1, 1) }
    ack(m - 1, ack(m, n - 1))
}

// A loop's measure can be a tuple too.
fn walk(n: i64) -> i64
    requires n >= 0
{
    var i = n
    var j = 3
    var steps = 0
    while i > 0
        invariant i >= 0 && j >= 0
        decreases (i, j)
    {
        if j > 0 { j -= 1 } else {
            i -= 1
            j = 3
        }
        steps +%= 1
    }
    steps
}

fn even(n: i64) -> bool
    requires n >= 0
    decreases n
{
    if n == 0 { return true }
    odd(n - 1)
}

fn odd(n: i64) -> bool
    requires n >= 0
    decreases n
{
    if n == 0 { return false }
    even(n - 1)
}

// Measures of different lengths: `g`'s is compared with the first part
// of `f`'s.
fn f(a: i64, b: i64) -> i64
    requires a >= 0 && b >= 0
    decreases (a, b)
{
    if a == 0 { return b }
    if b > 0 { return f(a, b - 1) }
    g(a - 1)
}

fn g(a: i64) -> i64
    requires a >= 0
    decreases a
{
    if a == 0 { return 0 }
    f(a - 1, 5)
}

fn main() {
    println(fact(5))
    println(gcd(12, 18))
    println(bsearch([1, 3, 5, 7], 5, 0, 4))
    println(ack(2, 3))
    println(walk(2))
    println(even(10))
    println(odd(10))
    println(f(3, 2))
}

