// `decreases d` on a function: every call to itself passes arguments for
// which `d` is smaller, and `d` is not negative on entry, so the recursion
// ends. Calls through other functions are not followed.

fn fact(n: i64) -> i64
    requires n >= 0
    decreases n
{
    if n == 0 { 1 } else { n *% fact(n - 1) }
}

fn gcd(a: i64, b: i64) -> i64
    requires a >= 0 && b >= 0
    decreases b
{
    if b == 0 { a } else { gcd(b, a % b) }
}

fn bsearch(xs: [i64], key: i64, lo: i64, hi: i64) -> i64
    requires 0 <= lo <= hi <= xs.len
    decreases hi - lo
{
    if lo >= hi { return lo }
    let mid = lo + (hi - lo) / 2
    if xs[mid] < key { bsearch(xs, key, mid + 1, hi) } else { bsearch(xs, key, lo, mid) }
}

fn main() {
    println(fact(5))
    println(gcd(12, 18))
    println(bsearch([1, 3, 5, 7], 5, 0, 4))
}

//> 9:38: proved integer overflow in fact
//> 24:20: proved integer overflow in bsearch
//> 24:15: proved integer overflow in bsearch
//> 25:8: proved index out of bounds in bsearch
//> 25:41: proved integer overflow in bsearch
