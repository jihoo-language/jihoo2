// Slices of arrays borrow the array, and the elements of a slice of views
// borrow what the views do, not the array: a temporary array lives to the
// end of its block, and a `Vec` copied out of an array of literals can
// leave the block.
fn sum(xs: [i64]) -> i64 {
    var s = 0
    for x in xs { s += x }
    s
}

fn main() {
    let xs: [i64] = [1, 2, 3, 4]
    println(sum(xs))
    //> 10
    var a = [5, 6, 7]
    println(sum(a[1..]))
    //> 13
    a[0] = 1
    println(sum(a))
    //> 14
    let words = {
        let w = ["x", "y"].to_vec()
        w
    }
    println(words)
    //> [x, y]
    let text = String.from("a b")
    let parts = {
        let p = [text.as_str()]
        p.to_vec()
    }
    println(parts)
    //> [a b]
}
