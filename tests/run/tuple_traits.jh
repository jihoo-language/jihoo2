// Tuples have `==`, `compare` (and `<`), `hash`, `clone` and `Show` when
// each element does, so they work as map keys; `Option`, `Result`, `Vec`
// and `Ordering` show too.
import std.map

fn main() {
    let t = (1, "a", true)
    println(t)
    println((String.from("x"),))
    println(t == (1, "a", true))
    println(t != (1, "b", true))
    println((1, 2).compare((1, 3)) == Ordering.Less)
    println((1, 2) < (1, 3))
    let owned = (String.from("s"), 5)
    let copy = owned.clone()
    println(copy == owned)
    println((1, 2).hash() == (1, 2).hash() && (1, 2).hash() != (2, 1).hash())
    var m = Map((i64, i64), str).new()
    m.insert((1, 2), "one-two")
    println(m.contains((1, 2)) && !m.contains((2, 1)))
    println(Some(3))
    let none: Option(i64) = None
    println(none)
    let r: Result(i64, String) = Err(String.from("bad"))
    println(r)
    var v = Vec((i64, str)).new()
    v.push((1, "a"))
    v.push((2, "b"))
    println(v)
    println(v[0] == (1, "a"))
    var w = Vec(Option(i64)).new()
    w.push(Some(1))
    w.push(None)
    println(w)
    println(((1, 2), (3, (4, 5))))
}
//> (1, a, true)
//> (x,)
//> true
//> true
//> true
//> true
//> true
//> true
//> true
//> Some(3)
//> None
//> Err(bad)
//> [(1, a), (2, b)]
//> true
//> [Some(1), None]
//> ((1, 2), (3, (4, 5)))
