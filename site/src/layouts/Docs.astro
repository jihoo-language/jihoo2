---
// A documentation page: the sidebar from docs/README.md, the page text, the
// headings of this page, and the pages before and after it.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import { GITHUB, contains, isPage, pages, sidebar, url, type NavGroup, type NavPage } from '../lib/site';

interface Props {
  slug: string;
  title: string;
  description?: string;
  source?: string;
  headings: MarkdownHeading[];
}

const { slug, title, description, source, headings } = Astro.props;
const order = pages();
const at = order.findIndex((p) => p.slug === slug);
const current = order[at];
const prev = at > 0 ? order[at - 1] : undefined;
const next = at >= 0 && at < order.length - 1 ? order[at + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const section = slug.startsWith('examples/') ? 'examples' : 'docs';
const editUrl = source ? `${GITHUB}/blob/main/${source}` : undefined;

type Item = NavPage | NavGroup;
---

<Base title={title} description={description} section={section} menu>
  <div class="docs">
    <aside class="sidebar" aria-label="Documentation">
      {
        sidebar.map((group) => (
          <details open={contains(group, slug) || group.label === 'Start here' || undefined}>
            <summary>{group.label}</summary>
            <ul>
              {group.items.map(function entry(item: Item): any {
                return isPage(item) ? (
                  <li>
                    <a href={url(item.slug)} aria-current={item.slug === slug ? 'page' : undefined}>
                      <span>{item.label}</span>
                      {item.badge && <span class="badge">{item.badge}</span>}
                    </a>
                  </li>
                ) : (
                  <li>
                    <details open={contains(item, slug) || undefined}>
                      <summary>{item.label}</summary>
                      <ul>{item.items.map(entry)}</ul>
                    </details>
                  </li>
                );
              })}
            </ul>
          </details>
        ))
      }
    </aside>
    <div class="sidebar-backdrop"></div>

    <main class="doc-main">
      <article>
        <div class="breadcrumbs">
          <span>{current?.group ?? 'Docs'}</span>
          <span>{current?.label ?? title}</span>
        </div>
        <h1 class="doc-title">{title}</h1>
        <div class="prose">
          <slot />
        </div>
      </article>
      <footer class="doc-footer">
        {
          editUrl && (
            <a class="edit-link" href={editUrl}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
              </svg>
              Edit on GitHub
            </a>
          )
        }
        <nav class="pager" aria-label="Pages">
          {
            prev && (
              <a href={url(prev.slug)} rel="prev">
                <small>← Previous</small>
                <strong>{prev.label}</strong>
              </a>
            )
          }
          {
            next && (
              <a class="next" href={url(next.slug)} rel="next">
                <small>Next →</small>
                <strong>{next.label}</strong>
              </a>
            )
          }
        </nav>
      </footer>
    </main>

    <nav class="toc" aria-label="On this page">
      {
        toc.length > 0 && (
          <>
            <h2>On this page</h2>
            <ul>
              <li>
                <a href="#_top" data-top>
                  Overview
                </a>
              </li>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class={`depth-${h.depth}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </nav>
  </div>
</Base>

<script>
  // Marks the heading being read in "On this page".
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a:not([data-top])')];
  const top = document.querySelector<HTMLAnchorElement>('.toc a[data-top]');
  top?.addEventListener('click', (event) => {
    event.preventDefault();
    scrollTo({ top: 0, behavior: 'smooth' });
  });
  const targets = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);
  const mark = () => {
    let active = -1;
    targets.forEach((el, i) => {
      if (el.getBoundingClientRect().top < 140) active = i;
    });
    [top, ...links].forEach((a) => a?.removeAttribute('data-active'));
    (active < 0 ? top : links[active])?.setAttribute('data-active', '');
  };
  addEventListener('scroll', mark, { passive: true });
  mark();

  // Keeps the current page in view in a long sidebar.
  document.querySelector('.sidebar a[aria-current="page"]')?.scrollIntoView({ block: 'center' });

  // A link icon after each heading of the page text.
  for (const h of document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]')) {
    const a = document.createElement('a');
    a.className = 'anchor';
    a.href = `#${h.id}`;
    a.setAttribute('aria-label', `Link to ${h.textContent}`);
    a.textContent = '#';
    h.append(a);
  }
</script>
