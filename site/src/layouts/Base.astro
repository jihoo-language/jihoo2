---
// The page frame every page shares: head, header with search and theme
// toggle, footer, and the small scripts they need.
import '../styles/global.css';
import { GITHUB, VERSION, url } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  section?: 'docs' | 'examples' | 'home';
  menu?: boolean;
}

const { title, description, section = 'home', menu = false } = Astro.props;
const siteTitle = title === 'jihoo2' ? title : `${title} · jihoo2`;
const summary =
  description ?? 'A systems language as fast as C, memory-safe without lifetimes or a garbage collector.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg').replace(/\/$/, '')} type="image/svg+xml" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#05060a" />
    <script is:inline>
      // Before the first paint, so that a light-theme reader never sees a flash of dark.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="inner">
        {
          menu && (
            <button class="icon-button menu-button" type="button" aria-label="Show the table of contents" data-menu-toggle>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 7h16M4 12h16M4 17h10" />
              </svg>
            </button>
          )
        }
        <a class="brand" href={url()}>
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
            <defs>
              <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#2ee6c5" />
                <stop offset="0.5" stop-color="#38bdf8" />
                <stop offset="1" stop-color="#a78bfa" />
              </linearGradient>
            </defs>
            <rect width="32" height="32" rx="8" fill="url(#brand-g)" />
            <path d="M19 7v12.5a5.5 5.5 0 0 1-11 0" fill="none" stroke="#05060a" stroke-width="3.2" stroke-linecap="round" />
          </svg>
          jihoo2
          <span class="version">v{VERSION}</span>
        </a>
        <nav class="nav-links" aria-label="Site">
          <a href={url('start/getting-started')} aria-current={section === 'docs' ? 'true' : undefined}>Docs</a>
          <a href={url('examples/hello')} aria-current={section === 'examples' ? 'true' : undefined}>Examples</a>
          <a href={url('reference/standard-library')}>Library</a>
          <a href={`${GITHUB}/releases`}>Releases</a>
        </nav>
        <div class="header-actions">
          <button class="search-button" type="button" data-search-open aria-label="Search the documentation">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <span class="label">Search docs…</span>
            <kbd>Ctrl K</kbd>
          </button>
          <button class="icon-button theme-toggle" type="button" aria-label="Switch between light and dark" data-theme-toggle>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
            </svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
          <a class="icon-button" href={GITHUB} aria-label="jihoo2 on GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="inner">
        <span>jihoo2 v{VERSION} · Apache-2.0 · jihoo without dependent types</span>
        <nav aria-label="Footer">
          <a href={url('start/getting-started')}>Get started</a>
          <a href={url('language/tour')}>Tour</a>
          <a href={url('internals/roadmap')}>Roadmap</a>
          <a href={GITHUB}>GitHub</a>
        </nav>
      </div>
    </footer>

    <dialog class="search-dialog" aria-label="Search">
      <div class="search-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input type="search" placeholder="Search pages, headings and text" autocomplete="off" spellcheck="false" aria-label="Search" />
        <kbd>Esc</kbd>
      </div>
      <ul class="search-results" role="listbox"></ul>
      <div class="search-footer"><span><kbd>↑</kbd> <kbd>↓</kbd> to move</span><span><kbd>Enter</kbd> to open</span></div>
    </dialog>

    <script is:inline define:vars={{ index: url('search.json').replace(/\/$/, '') }}>
      window.__searchIndex = index;
    </script>
    <script>
      // ---- Theme ----
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      // ---- Reading progress ----
      const progress = document.querySelector<HTMLElement>('.progress');
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        progress?.style.setProperty('--progress', String(max > 0 ? scrollY / max : 0));
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // ---- Code frames, copy buttons and tables in page text ----
      const copy = async (button: HTMLElement, text: string) => {
        try {
          await navigator.clipboard.writeText(text);
          button.dataset.copied = '';
          const label = button.textContent;
          button.textContent = 'Copied';
          setTimeout(() => {
            delete button.dataset.copied;
            button.textContent = label;
          }, 1400);
        } catch {}
      };
      for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code')) {
        const frame = document.createElement('div');
        frame.className = 'code-frame';
        pre.replaceWith(frame);
        if (pre.dataset.title) {
          const title = document.createElement('div');
          title.className = 'code-title';
          title.textContent = pre.dataset.title;
          frame.append(title);
        }
        frame.append(pre);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-button';
        button.textContent = 'Copy';
        button.addEventListener('click', () => copy(button, pre.innerText.replace(/\n$/, '')));
        frame.append(button);
      }
      for (const table of document.querySelectorAll('.prose table')) {
        const wrap = document.createElement('div');
        wrap.className = 'table-wrap';
        table.replaceWith(wrap);
        wrap.append(table);
      }
      for (const button of document.querySelectorAll<HTMLElement>('[data-copy]')) {
        button.addEventListener('click', () => copy(button, button.dataset.copy ?? ''));
      }

      // ---- Mobile table of contents ----
      document.querySelector('[data-menu-toggle]')?.addEventListener('click', () => {
        document.body.toggleAttribute('data-menu');
      });
      document.querySelector('.sidebar-backdrop')?.addEventListener('click', () => {
        document.body.removeAttribute('data-menu');
      });

      // ---- Search ----
      type Entry = { t: string; u: string; g: string; d: string; h: string[]; b: string };
      const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
      const input = dialog.querySelector('input')!;
      const list = dialog.querySelector('.search-results')!;
      let entries: Entry[] | undefined;
      let selected = 0;

      const escape = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
      const highlight = (text: string, words: string[]) => {
        let html = escape(text);
        for (const w of words) {
          if (w) html = html.replace(new RegExp(`(${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi'), '<mark>$1</mark>');
        }
        return html;
      };
      const snippet = (body: string, word: string) => {
        const at = body.toLowerCase().indexOf(word);
        if (at < 0) return body.slice(0, 140);
        const start = Math.max(0, at - 50);
        return (start > 0 ? '…' : '') + body.slice(start, start + 140);
      };

      const render = () => {
        const query = input.value.trim().toLowerCase();
        const words = query.split(/\s+/).filter(Boolean);
        if (!entries) return;
        let hits: { e: Entry; score: number }[];
        if (words.length === 0) {
          hits = entries.filter((e) => e.g === 'Start here' || e.u.endsWith('/language/tour/')).map((e) => ({ e, score: 1 }));
        } else {
          hits = [];
          for (const e of entries) {
            const title = e.t.toLowerCase();
            const heads = e.h.join(' ').toLowerCase();
            const body = e.b.toLowerCase();
            let score = 0;
            for (const w of words) {
              const s = (title.includes(w) ? (title.startsWith(w) ? 12 : 8) : 0) + (heads.includes(w) ? 4 : 0) + (body.includes(w) ? 1 : 0);
              if (s === 0) {
                score = 0;
                break;
              }
              score += s;
            }
            if (score > 0) hits.push({ e, score });
          }
          hits.sort((a, b) => b.score - a.score);
        }
        hits = hits.slice(0, 12);
        selected = Math.min(selected, Math.max(0, hits.length - 1));
        list.innerHTML = hits.length
          ? hits
              .map(
                ({ e }, i) =>
                  `<li><a href="${e.u}" role="option" aria-selected="${i === selected}"><span class="hit-title"><span>${highlight(e.t, words)}</span><span class="hit-group">${escape(e.g)}</span></span><span class="hit-text">${highlight(words.length ? snippet(e.b, words[0]) : e.d, words)}</span></a></li>`,
              )
              .join('')
          : `<li class="search-empty">Nothing matches “${escape(input.value)}”.</li>`;
      };

      const open = async () => {
        if (!dialog.open) dialog.showModal();
        input.select();
        if (!entries) {
          try {
            entries = await (await fetch((window as any).__searchIndex)).json();
          } catch {
            entries = [];
          }
        }
        render();
      };
      document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
      addEventListener('keydown', (event) => {
        const typing = event.target instanceof HTMLElement && event.target.closest('input, textarea, [contenteditable]');
        if ((event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing)) {
          event.preventDefault();
          open();
        }
      });
      input.addEventListener('input', () => {
        selected = 0;
        render();
      });
      input.addEventListener('keydown', (event) => {
        const links = [...list.querySelectorAll('a')];
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          selected = (selected + (event.key === 'ArrowDown' ? 1 : -1) + links.length) % Math.max(links.length, 1);
          links.forEach((a, i) => a.setAttribute('aria-selected', String(i === selected)));
          links[selected]?.scrollIntoView({ block: 'nearest' });
        } else if (event.key === 'Enter' && links[selected]) {
          event.preventDefault();
          location.href = links[selected].href;
        }
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    </script>
  </body>
</html>
